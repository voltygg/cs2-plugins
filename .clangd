# clangd configuration for the Admin System plugin.
# Mirrors the compile flags and include set produced by src/AMBuilder so the
# language server resolves SDK / CS2Kit headers the same way the real build does.
# If clangd still can't find a header, make sure submodules and vcpkg deps are
# installed (see CONTRIBUTING.md / docs/local-development.md).

CompileFlags:
  Add:
    - -std=c++23
    - -DMETA_IS_SOURCE2
    - -DSE_CS2=25
    - -DSOURCE_ENGINE=25
    - -DCOMPILER_MSVC
    - -DPLATFORM_64BITS
    # Plugin + CS2Kit sources
    - -Isrc
    - -Ivendor/cs2-kit/include
    - -Ivendor/cs2-kit/src
    # hl2sdk-cs2
    - -Ivendor/cs2-kit/vendor/hl2sdk-cs2/public
    - -Ivendor/cs2-kit/vendor/hl2sdk-cs2/public/tier0
    - -Ivendor/cs2-kit/vendor/hl2sdk-cs2/public/tier1
    - -Ivendor/cs2-kit/vendor/hl2sdk-cs2/common
    # Metamod:Source
    - -Ivendor/cs2-kit/vendor/mmsource-2.0/core
    - -Ivendor/cs2-kit/vendor/mmsource-2.0/core/sourcehook
    # vcpkg (libpqxx / libpq, libcurl, OpenSSL headers)
    - -Ivcpkg_installed/x64-windows-static/include
    # nlohmann/json (vendored by CS2Kit)
    - -Ivendor/cs2-kit/vendor/nlohmann/single_include

Diagnostics:
  Suppress:
    - unusedIncludes
