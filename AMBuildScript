# ruff: noqa: F821
# mypy: ignore-errors
#
# Root build for the cs2-plugins monorepo: resolve the SDK/Metamod once, then
# build every plugins/<name>/src/AMBuilder. 'builder' is injected by AMBuild.

import os

VCPKG_TRIPLET = "x64-windows-static"  # Windows vcpkg dependency triplet

PROJECT_ROOT = os.path.dirname(os.path.abspath(__file__))
CS2KIT_ROOT_DIR = os.path.join(PROJECT_ROOT, "vendor", "cs2-kit")
CS2KIT_VENDOR_DIR = os.path.join(CS2KIT_ROOT_DIR, "vendor")
CS2KIT_INCLUDE_DIR = os.path.join(CS2KIT_ROOT_DIR, "include")
CS2KIT_SRC_DIR = os.path.join(CS2KIT_ROOT_DIR, "src")


def discover_cpp(root):
    """All .cpp files under `root`, sorted for deterministic builds."""
    return sorted(
        os.path.join(r, f)
        for r, _, files in os.walk(root)
        for f in files if f.endswith(".cpp")
    )


# cs2-kit is compiled inline into every plugin (source inclusion).
CS2KIT_SOURCES = discover_cpp(CS2KIT_SRC_DIR)


def resolve_vendor_path(folder):
    """Resolve a path from cs2-kit's vendor/ submodules."""
    path = os.path.join(CS2KIT_VENDOR_DIR, folder)
    return path if os.path.isdir(path) else None


def resolve_mms_root():
    path = builder.options.mms_path or resolve_vendor_path("mmsource-2.0")
    if not path or not os.path.isdir(path):
        raise Exception(
            "Could not find Metamod:Source 2.0. "
            "Run 'git submodule update --init --recursive' first."
        )
    return os.path.abspath(os.path.normpath(path))


def resolve_hl2sdk_manifests_root():
    path = builder.options.hl2sdk_manifests or resolve_vendor_path("hl2sdk-manifests")
    if not path or not os.path.isdir(path):
        raise Exception(
            "Could not find HL2SDK manifests. "
            "Run 'git submodule update --init --recursive' first."
        )
    return os.path.abspath(os.path.normpath(path))


mms_root = resolve_mms_root()
hl2sdk_manifests_root = resolve_hl2sdk_manifests_root()
SdkHelpers = builder.Eval(
    os.path.join(hl2sdk_manifests_root, "SdkHelpers.ambuild"), {"Project": "metamod"}
)

# cs2-kit owns the list of SDK .proto files it (and every consumer) needs.
Protobuf = builder.Eval(os.path.join(CS2KIT_ROOT_DIR, "Protobuf.ambuild"))


class PluginConfig:
    """Shared SDK + compiler setup; builds each plugin via add_plugin()."""

    def __init__(self):
        self.sdks = {}
        self.sdk_manifests = []
        self.sdk_targets = []
        self.binaries = []
        self.mms_root = mms_root
        self.all_targets = []
        self.target_archs = set()

        target_archs = builder.options.targets.split(",") if builder.options.targets else ["x86_64"]
        for arch in target_archs:
            try:
                cxx = builder.DetectCxx(target_arch=arch)
                self.target_archs.add(cxx.target.arch)
                self.all_targets.append(cxx)
            except Exception as e:
                if builder.options.targets:
                    raise
                print(f"Skipping target {arch}: {e}")

        if not self.all_targets:
            raise Exception("No suitable C/C++ compiler was found.")

    def find_sdk_path(self, sdk_name):
        dir_name = f"hl2sdk-{sdk_name}"
        if builder.options.hl2sdk_root:
            sdk_path = os.path.abspath(os.path.normpath(
                os.path.join(builder.options.hl2sdk_root, dir_name)
            ))
            if os.path.exists(sdk_path):
                return sdk_path
        return resolve_vendor_path(dir_name)

    def detect_sdks(self):
        sdk_list = [s for s in builder.options.sdks.split(",") if s]
        SdkHelpers.find_sdk_path = self.find_sdk_path
        SdkHelpers.findSdks(builder, self.all_targets, sdk_list)

        self.sdks = SdkHelpers.sdks
        self.sdk_manifests = SdkHelpers.sdk_manifests
        self.sdk_targets = SdkHelpers.sdk_targets

        for sdk_target in self.sdk_targets:
            if not sdk_target.sdk["source2"]:
                raise Exception("Only Source 2 games are supported.")

        if self.sdk_targets:
            print(f"Using HL2SDK: {self.sdk_targets[0].sdk['path']}")
        print(f"Using Metamod:Source: {self.mms_root}")

    def configure(self):
        for cxx in self.all_targets:
            if cxx.target.arch not in ["x86", "x86_64"]:
                raise Exception(f"Unknown target architecture: {cxx.target.arch}")
            self._configure_compiler(cxx)

    def _configure_compiler(self, cxx):
        if cxx.behavior == "gcc":
            self._configure_gcc(cxx)
        elif cxx.like("msvc"):
            self._configure_msvc(cxx)

        self._configure_optimization(cxx)
        self._configure_platform(cxx)

    def _configure_gcc(self, cxx):
        cxx.defines += [
            "stricmp=strcasecmp", "_stricmp=strcasecmp",
            "_snprintf=snprintf", "_vsnprintf=vsnprintf",
            "HAVE_STDINT_H", "GNUC",
        ]
        cxx.cflags += [
            "-pipe", "-fno-strict-aliasing", "-Wall",
            "-Wno-sign-compare", "-Wno-uninitialized", "-Wno-unused",
            "-Wno-switch", "-msse", "-fPIC",
        ]
        cxx.cxxflags += ["-std=c++23"]

        if cxx.version >= "gcc-4.0" or cxx.family == "clang":
            cxx.cflags += ["-fvisibility=hidden"]
            cxx.cxxflags += ["-fvisibility-inlines-hidden"]

        cxx.cxxflags += [
            "-fno-exceptions", "-fno-threadsafe-statics",
            "-Wno-non-virtual-dtor", "-Wno-overloaded-virtual",
            "-Wno-register", "-Wno-invalid-offsetof",
        ]

        if cxx.version >= "gcc-4.7" or cxx.family == "clang":
            cxx.cxxflags += ["-Wno-delete-non-virtual-dtor"]
        if cxx.family == "gcc":
            cxx.cflags += ["-mfpmath=sse"]

    def _configure_msvc(self, cxx):
        if builder.options.debug == "1":
            cxx.cflags += ["/MTd"]
            cxx.linkflags += ["/NODEFAULTLIB:libcmt"]
        else:
            cxx.cflags += ["/MT"]

        cxx.defines += [
            "_CRT_SECURE_NO_DEPRECATE", "_CRT_SECURE_NO_WARNINGS",
            "_CRT_NONSTDC_NO_DEPRECATE", "NOMINMAX",
        ]
        cxx.cflags += ["/W3", "/std:c++latest", "/EHsc"]
        cxx.cxxflags += ["/TP"]
        cxx.linkflags += [
            "/SUBSYSTEM:WINDOWS",
            "kernel32.lib", "user32.lib", "gdi32.lib", "winspool.lib",
            "comdlg32.lib", "advapi32.lib", "shell32.lib", "ole32.lib",
            "oleaut32.lib", "uuid.lib", "odbc32.lib", "odbccp32.lib", "ws2_32.lib",
        ]

    def _configure_optimization(self, cxx):
        if builder.options.opt == "1":
            cxx.defines += ["NDEBUG"]
            if cxx.behavior == "gcc":
                cxx.cflags += ["-O3"]
            elif cxx.behavior == "msvc":
                cxx.cflags += ["/Ox", "/Zo"]
                cxx.linkflags += ["/OPT:ICF", "/OPT:REF"]

        if builder.options.debug == "1":
            cxx.defines += ["DEBUG", "_DEBUG"]
            if cxx.behavior == "gcc":
                cxx.cflags += ["-g3"]
            elif cxx.behavior == "msvc":
                cxx.cflags += ["/Od", "/RTC1"]

    def _configure_platform(self, cxx):
        if cxx.target.platform == "linux":
            cxx.defines += ["LINUX", "_LINUX", "POSIX", "_FILE_OFFSET_BITS=64"]
            if cxx.family == "gcc":
                cxx.linkflags += ["-static-libgcc"]
            elif cxx.family == "clang":
                cxx.linkflags += ["-lgcc_eh"]
            cxx.linkflags += ["-static-libstdc++"]
        elif cxx.target.platform == "windows":
            cxx.defines += ["WIN32", "_WINDOWS"]

    def create_library(self, context, sdk_target, plugin_name):
        """A plugin binary with SDK includes, Metamod, protobuf, and vcpkg wired up."""
        sdk = sdk_target.sdk
        binary = sdk_target.cxx.Library(plugin_name)
        cxx = binary.compiler
        mms_core = os.path.join(self.mms_root, "core")

        # SDK/cs2-kit protobuf headers (.pb.h/.pb.cc) — required by every plugin.
        Protobuf.attach(context, binary, sdk_target)

        cxx.cxxincludes += [context.currentSourcePath, mms_core, os.path.join(mms_core, "sourcehook")]

        for other_sdk in self.sdk_manifests:
            cxx.defines += [f"SE_{other_sdk['define']}={other_sdk['code']}"]

        if sdk["source2"]:
            cxx.defines += ["META_IS_SOURCE2"]
            binary.sources += [
                os.path.join(sdk["path"], "public", "tier0", "memoverride.cpp"),
                os.path.join(sdk["path"], "tier1", "convar.cpp"),
            ]

        SdkHelpers.configureCxx(context, binary, sdk)

        # vcpkg static deps (Windows).
        if cxx.like("msvc"):
            vcpkg_path = os.path.join(builder.sourcePath, "vcpkg_installed", VCPKG_TRIPLET)
            if os.path.isdir(vcpkg_path):
                cxx.cxxincludes += [os.path.join(vcpkg_path, "include")]
                cxx.linkflags += [f"/LIBPATH:{os.path.join(vcpkg_path, 'lib')}"]

        return binary

    def add_plugin(self, context, name, windows_libs=None, linux_libs=None, includes=None):
        """Build one plugin from its own src/ plus inlined cs2-kit. A plugin's
        AMBuilder only calls this and declares the libraries it links."""
        for sdk_target in self.sdk_targets:
            binary = self.create_library(context, sdk_target, name)
            cxx = binary.compiler

            cxx.cxxincludes += [CS2KIT_INCLUDE_DIR, CS2KIT_SRC_DIR, *(includes or [])]
            binary.sources += discover_cpp(context.currentSourcePath)
            binary.sources += CS2KIT_SOURCES

            if cxx.like("msvc"):
                cxx.linkflags += windows_libs or []
            else:
                cxx.linkflags += [f"-l{lib}" for lib in linux_libs or []]

            self.binaries += [context.Add(binary)]


# Build every plugin discovered at plugins/<name>/src/AMBuilder.
Plugin = PluginConfig()
Plugin.detect_sdks()
Plugin.configure()

PLUGINS_DIR = os.path.join(PROJECT_ROOT, "plugins")
plugin_names = sorted(
    d for d in os.listdir(PLUGINS_DIR)
    if os.path.isfile(os.path.join(PLUGINS_DIR, d, "src", "AMBuilder"))
)
if not plugin_names:
    raise Exception(f"No plugins found under {PLUGINS_DIR} (expected plugins/<name>/src/AMBuilder).")

for name in plugin_names:
    builder.Build(
        [os.path.join("plugins", name, "src", "AMBuilder")],
        {"Plugin": Plugin, "PluginName": name},
    )
