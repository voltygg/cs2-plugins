# ruff: noqa: F821
# mypy: ignore-errors
#
# Admin System - Source AMBuilder
#
# Note: 'builder' and 'AdminSystem' are injected at runtime by AMBuild

# Create plugin library
binary = AdminSystem.HL2Library(builder, "admin-system")

# Source files
binary.sources += [
    # Core
    "core/plugin.cpp",
    # Add more source files as they are created
]

# Libraries for Windows (detect via compiler)
if binary.compiler.like("msvc"):
    binary.compiler.linkflags += [
        "libpq.lib",
        "pqxx.lib",
    ]

# Add binary to the build
builder.Add(binary)
