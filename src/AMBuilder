    # Core
    "core/plugin.cpp",
    "core/config.cpp",

    # SDK
    "sdk/schema.cpp",
    "sdk/usermessage.cpp",
    "sdk/entity.cpp",
    "sdk/sigscanner.cpp",

    # Utilities
    "utils/steamid.cpp",
    "utils/time.cpp",
    "utils/string.cpp",
    "utils/translations.cpp",

    # Database
    "database/database.cpp",
    "database/entities/admin.cpp",
    "database/entities/admin_group.cpp",
    "database/entities/ban.cpp",
    "database/entities/mute.cpp",
    "database/entities/gag.cpp",
    "database/repositories/admin_repository.cpp",
    "database/repositories/ban_repository.cpp",

    # Player
    "player/player.cpp",
    "player/player_manager.cpp",

    # Admin
    "admin/admin_manager.cpp",

    # Commands
    "commands/command.cpp",
    "commands/command_manager.cpp",

    # Punishments
    "punishments/punishment_manager.cpp",

    # Menus
    "menus/menu_renderer.cpp",
    "menus/menu_manager.cpp",
    "menus/admin_menu.cpp",
]

# =============================================================================
# LIBRARIES - Platform-specific libraries
# =============================================================================
WINDOWS_LIBS = [
    # libpqxx + libpq (static)
    "pqxx.lib",
    "libpq.lib",
    "libpgcommon.lib",
    "libpgport.lib",
    # OpenSSL (static, required by libpq)
    "libssl.lib",
    "libcrypto.lib",
    # Compression (static, required by libpq)
    "zlib.lib",
    "lz4.lib",
    # Windows system libs required by OpenSSL/libpq
    "crypt32.lib",
    "secur32.lib",
    "wldap32.lib",
    # Required by sigscanner (GetModuleInformation)
    "psapi.lib",
]

LINUX_LIBS = [
    "pqxx",
    "pq",
]

# =============================================================================
# BUILD - No changes needed below
# =============================================================================

for sdk_target in Plugin.sdk_targets:
    sdk = sdk_target.sdk
    cxx = sdk_target.cxx

    binary = Plugin.create_library(builder, cxx, sdk)

    # Add source files
    for src in SOURCES:
        binary.sources += [os.path.join(builder.sourcePath, "src", src)]

    # Link libraries
    if binary.compiler.like("msvc"):
        binary.compiler.linkflags += WINDOWS_LIBS
    else:
        for lib in LINUX_LIBS:
            binary.compiler.linkflags += [f"-l{lib}"]

    Plugin.binaries += [builder.Add(binary)]
