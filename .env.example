# Local CS2 development. Copy this file to .env and adjust the paths.
CS2_SERVER_PATH=C:/cs2-server
# Your own CS2 client, for `poe panorama`. Found via Steam when unset.
#CS2_CLIENT_PATH=
STEAMCMD_PATH=C:/Program Files/steamcmd/steamcmd.exe
CS2_BUILD_PRESET=windows-msvc-release
CS2_MAP=de_dust2
CS2_PORT=27015
CS2_MAX_PLAYERS=16
GSLT_TOKEN=
RCON_PASSWORD=
