# Dev convenience: one IDE, both repos. Not a build input - conanfile.py pins the version
# unless you `conan editable add vendor/voltmod`. ignore = all keeps the moving pointer out
# of this repo's status; drop it to track the gitlink instead.
[submodule "vendor/voltmod"]
	path = vendor/voltmod
	url = https://github.com/voltygg/voltmod.git
	ignore = all
