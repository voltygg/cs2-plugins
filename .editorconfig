# EditorConfig - https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C/C++ files
[*.{c,cpp,h,hpp,inl}]
indent_size = 4

# Header files
[*.{h,hpp}]
indent_size = 4

# JSON files
[*.json]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# XML files (Panorama layouts)
[*.xml]
indent_size = 2

# JavaScript (Panorama scripts)
[*.js]
indent_size = 2

# CSS (Panorama styles)
[*.css]
indent_size = 2

# SQL files
[*.sql]
indent_size = 2

# Python (AMBuild)
[*.py]
indent_size = 4

# AMBuild files
[AMBuilder]
indent_size = 4

[AMBuildScript]
indent_size = 4

# Markdown
[*.md]
trim_trailing_whitespace = false

# Batch/PowerShell scripts
[*.{bat,cmd,ps1}]
end_of_line = crlf

# Dockerfile
[Dockerfile]
indent_size = 2

# Docker Compose
[docker-compose.yml]
indent_size = 2
