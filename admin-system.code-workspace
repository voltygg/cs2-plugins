{
  "folders": [
    {
      "name": "admin-system",
      "path": "."
    },
    {
      "name": "cs2-kit (submodule)",
      "path": "vendor/cs2-kit"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/build": true,
      "**/objdir": true,
      "**/.vs": true,
      "**/__pycache__": true,
      "**/.mypy_cache": true
    },
    "search.exclude": {
      "**/vcpkg_installed": true,
      "**/objdir": true,
      "**/references": true,
      "vendor/cs2-kit/vendor": true,
      "vendor/hl2sdk-cs2": true,
      "vendor/mmsource-2.0": true,
      "vendor/nlohmann": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-vscode.cpptools",
      "esbenp.prettier-vscode",
      "charliermarsh.ruff",
      "adpyke.vscode-sql-formatter"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build & Deploy",
        "type": "shell",
        "command": "bash",
        "args": ["scripts/build.sh"],
        "options": {
          "cwd": "${workspaceFolder:admin-system}"
        },
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": ["$msCompile"],
        "presentation": {
          "panel": "dedicated",
          "clear": true
        }
      },
      {
        "label": "Deploy only",
        "type": "shell",
        "command": "bash",
        "args": ["scripts/deploy.sh"],
        "options": {
          "cwd": "${workspaceFolder:admin-system}"
        },
        "problemMatcher": [],
        "presentation": {
          "panel": "dedicated"
        }
      },
      {
        "label": "Clean build artifacts",
        "type": "shell",
        "command": "rm -rf objdir build",
        "options": {
          "cwd": "${workspaceFolder:admin-system}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "silent"
        }
      },
      {
        "label": "Start CS2 Server",
        "type": "shell",
        "command": "bash",
        "args": ["scripts/start-server.sh"],
        "options": {
          "cwd": "${workspaceFolder:admin-system}"
        },
        "problemMatcher": [],
        "presentation": {
          "panel": "dedicated"
        },
        "isBackground": true
      },
      {
        "label": "Start PostgreSQL",
        "type": "shell",
        "command": "docker compose up -d postgres",
        "options": {
          "cwd": "${workspaceFolder:admin-system}"
        },
        "problemMatcher": []
      },
      {
        "label": "Stop PostgreSQL",
        "type": "shell",
        "command": "docker compose down",
        "options": {
          "cwd": "${workspaceFolder:admin-system}"
        },
        "problemMatcher": []
      },
      {
        "label": "PostgreSQL logs",
        "type": "shell",
        "command": "docker compose logs -f postgres",
        "options": {
          "cwd": "${workspaceFolder:admin-system}"
        },
        "problemMatcher": [],
        "presentation": {
          "panel": "dedicated"
        },
        "isBackground": true
      },
      {
        "label": "Generate cs2-kit docs (Doxygen)",
        "type": "shell",
        "command": "doxygen Doxyfile",
        "options": {
          "cwd": "${workspaceFolder:cs2-kit (submodule)}"
        },
        "problemMatcher": [],
        "presentation": {
          "panel": "dedicated"
        }
      }
    ]
  }
}
