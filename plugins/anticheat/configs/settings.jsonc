{
  "anticheat": {
    // Master switch. Off means no hooks feed the detection cores.
    "enabled": true,

    // Response funnel. "observe" only logs and reports, "alert" also notifies
    // admins (as_ac_alert), "ban" also kicks or bans (as_ac_ban). Soak in
    // observe before escalating.
    "mode": "observe",

    // Ban length in seconds for "ban" mode; 0 = permanent.
    "banDurationSec": 0,

    // SteamID64s that are reported but never punished (staff, testers).
    "whitelistSteamIds": [],

    // Detections switch off while sv_cheats is on, because cheat-protected client
    // cvars legitimately change. Set true only on a test box.
    "allowSvCheatsTesting": false,

    // Per-detection kill switches. Thresholds are compiled in, not configurable.
    "detections": {
      "aimbot": true,
      "aimlock": true,
      "antiAim": true,
      "silentAim": true,
      "dllInjection": true,
      "invalidCvar": true,
      "namechanger": true
    },

    // Discord reporting, inactive while url is empty.
    "webhook": {
      "url": ""
    },

    // Arms the built-in cheat simulator commands (dev boxes only).
    "debug": {
      "simulator": false
    }
  }
}
