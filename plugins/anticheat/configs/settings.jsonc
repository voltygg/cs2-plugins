{
  // Plugin-wide options.
  "plugin": {
    "logLevel": "info",
    "locale": "en"
  },

  "anticheat": {
    // Response ladder: "observe" logs only, "alert" also notifies admins via
    // admin-system (as_ac_alert), "ban" additionally auto-bans at ban score
    // (as_ac_ban). Keep "observe" until thresholds are tuned on the live server.
    "mode": "observe",
    "alertCooldownSec": 30.0,
    "historyDepth": 128,
    "ban": {
      "durationSec": 0, // 0 = permanent
      "reason": "AntiCheat: blatant input anomaly"
    },
    "detectors": {
      // Spinning alone NEVER bans (legit players fake-spin); ban tier needs
      // minKillEvents kills whose fire-tick aim snapped onto the victim mid-spin.
      "spin": {
        "enabled": true,
        "yawVelocityDegPerSec": 1800.0,
        "minTicks": 32,
        "killWindowTicks": 8,
        "onTargetEpsilonDeg": 8.0,
        "minKillEvents": 3,
        "eventWindowSec": 120.0,
        "spinOnlyScore": 5.0,
        "killEventScore": 40.0,
        "headshotMultiplier": 1.5,
        "alertScore": 60.0,
        "banScore": 110.0,
        "decayPerSec": 0.5
      },
      // Pre-fire flick > minSnapDeg that settles before the shot; only damage
      // landing on-target within confirmWindowTicks confirms it.
      "aimSnap": {
        "enabled": true,
        "lookbackTicks": 16,
        "minSnapDeg": 40.0,
        "settleEpsilonDeg": 1.0,
        "confirmWindowTicks": 4,
        "onTargetEpsilonDeg": 8.0,
        "minEvents": 4,
        "eventWindowSec": 180.0,
        "snapScore": 3.0,
        "confirmedHitScore": 25.0,
        "alertScore": 60.0,
        "banScore": 100.0,
        "decayPerSec": 0.5
      },
      // NaN/inf angles or pitch outside +/-maxPitchDeg sustained minTicks.
      "sanity": {
        "enabled": true,
        "maxPitchDeg": 89.5,
        "minTicks": 4,
        "minEvents": 1,
        "eventWindowSec": 60.0,
        "eventScore": 50.0,
        "alertScore": 50.0,
        "banScore": 50.0,
        "decayPerSec": 0.1
      },
      // Viewangle jump with ~zero mouse input = software wrote the aim.
      "silentAim": {
        "enabled": true,
        "minAngleJumpDeg": 20.0,
        "maxMouseUnits": 2,
        "confirmWindowTicks": 4,
        "onTargetEpsilonDeg": 8.0,
        "minEvents": 3,
        "eventWindowSec": 180.0,
        "eventScore": 35.0,
        "alertScore": 60.0,
        "banScore": 100.0,
        "decayPerSec": 0.5
      },
      // Kills landed while >= minRemainingSec of flash blindness remained.
      "noFlash": {
        "enabled": true,
        "minRemainingSec": 1.0,
        "minEvents": 3,
        "eventWindowSec": 120.0,
        "eventScore": 35.0,
        "alertScore": 60.0,
        "banScore": 100.0,
        "decayPerSec": 0.5
      }
    }
  }
}
