{
  "$schema": "./settings.schema.json",
  "anticheat": {
    // Disabled means hooks do not feed detector cores.
    "enabled": true,

    // `observe` reports, `alert` notifies admins, and `ban` punishes.
    "mode": "observe",

    // Ban length in seconds for "ban" mode; 0 = permanent.
    "banDurationSec": 0,

    // Reported but never punished.
    "whitelistSteamIds": [],

    // Allow detections under `sv_cheats`; test servers only.
    "allowSvCheatsTesting": false,

    // Per-detection kill switches. Thresholds are compiled in, not configurable.
    "detections": {
      "aimbot": true,
      "aimlock": true,
      "antiAim": true,
      "silentAim": true,
      "dllInjection": true,
      "invalidCvar": true,
      "namechanger": true
    },

    // Discord reporting, inactive while url is empty.
    "webhook": {
      "url": ""
    },

    // Arms the built-in cheat simulator commands (dev boxes only).
    "debug": {
      "simulator": false
    }
  }
}
