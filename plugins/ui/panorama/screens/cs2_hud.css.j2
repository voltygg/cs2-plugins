{#- The server HUD in the meat.gg look: near-black raised cards, red bars. -#}
{% include "card.css.j2" %}
{% include "toast.css.j2" %}
{% include "bar.css.j2" %}
{% include "icons.css.j2" %}
{% import "bar.css.j2" as bar %}
{% import "icons.css.j2" as icons %}

.Layer {
  width: 100%;
  height: 100%;
}

.Screen {
  width: 100%;
  height: 100%;
  color: #f7f4ee;
}

.Screen.Hidden {
  visibility: collapse;
}

.Region-top-left {
  width: 280px;
  height: fit-children;
  flow-children: down;
  horizontal-align: left;
  vertical-align: top;
  margin: 16px 0px 0px 16px;
}

.Region-bottom {
  width: fit-children;
  height: fit-children;
  horizontal-align: center;
  vertical-align: bottom;
  margin-bottom: 96px;
}

/* Cards: near-black surface over the framework's default, rounded, with a drop shadow. */
.Card {
  border-radius: 12px;
  background-color: #101015;
  border: 1px solid rgba(240, 221, 180, 0.09);
  box-shadow: 0px 2px 8px 0px rgba(0, 0, 0, 0.5);
}

.Icons {
  width: 40px;
  height: 40px;
  vertical-align: center;
  margin-left: 8px;
}

.Card-main {
  height: 54px;
}

.Card-body {
  padding: 0px 14px;
}

.Card-title {
  font-weight: medium;
  color: #f7f4ee;
}

.Card-subtitle {
  margin-top: 1px;
  color: #9a9aa4;
}

.Card-value {
  margin-right: 10px;
  font-weight: bold;
  color: #e0a040;
}

/* Along the card's bottom edge, rounded into its corners. */
.Card .Bar {
  height: 3px;
  background-color: rgba(240, 221, 180, 0.05);
  border-radius: 0px 0px 12px 12px;
}

.Bar-fill {
  background-color: #e1273c;
}

.Toast {
  background-color: #12121a;
  border: 1px solid rgba(240, 221, 180, 0.12);
  border-radius: 14px;
  box-shadow: 0px 4px 16px 0px rgba(0, 0, 0, 0.6);
}

.Toast-title {
  color: #f7f4ee;
}

.Toast-text {
  color: #9a9aa4;
}

{{ bar.fill_rules("Bar", 20) }}
{{ icons.show_rules("weapons") }}
