# admin-system — player management, punishments, and WASD admin menus.
# Plugin + cs2-kit sources are auto-discovered; just declare the libs to link.

Plugin.add_plugin(builder, PluginName,
    windows_libs=[
        # PostgreSQL: libpqxx + libpq and their static transitive deps.
        "pqxx.lib", "libpq.lib", "libpgcommon.lib", "libpgport.lib",
        # libcurl + OpenSSL + compression (static).
        "libcurl.lib", "libssl.lib", "libcrypto.lib", "zlib.lib", "lz4.lib",
        # System libs pulled in by OpenSSL/libpq/libcurl and the sigscanner.
        "crypt32.lib", "secur32.lib", "wldap32.lib", "iphlpapi.lib", "psapi.lib",
    ],
    linux_libs=["pqxx", "pq", "curl"],
)
