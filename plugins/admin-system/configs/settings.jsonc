{
  "$schema": "./settings.schema.json",
  "plugin": {
    // Translation file name without `.json`.
    "locale": "ru"
  },
  "server": {
    // Stable unique identity used by per-server grants.
    "tag": "default",
    // Display name registered in the servers table.
    "name": "CS2 Server"
  },
  "database": {
    "host": "localhost",
    "port": 5432,
    "database": "admin_system",
    "username": "postgres",
    "password": "Test12345#",
    // libpq SSL mode: "disable" | "allow" | "prefer" | "require" | "verify-ca" | "verify-full".
    "sslMode": "prefer"
  },
  "punishments": {
    // Recorded when an admin bans without giving a reason.
    "defaultBanReason": "Banned by administrator",
    // Warnings before escalation triggers.
    "warningThreshold": 3,
    // Shown to a banned player on the disconnect screen.
    "appeal": {
      // `{steamId}` is substituted; empty omits the appeal from the notice.
      "url": "",
      // Append how long the ban still has to run.
      "showExpiry": true
    },
    // Quick Punish presets; invalid entries are logged and skipped.
    // duration: "perm"/"0" for permanent, else <n>s / <n>m / <n>h / <n>d (bare = seconds).
    "templates": [
      { "name": "Cheating", "type": "ban", "duration": "perm", "reason": "Cheating" },
      { "name": "Griefing", "type": "ban", "duration": "1d", "reason": "Team damage / griefing" },
      { "name": "Mic spam", "type": "voiceMute", "duration": "30m", "reason": "Mic spam" },
      { "name": "Toxic voice", "type": "voiceMute", "duration": "2h", "reason": "Toxic behavior in voice" },
      { "name": "Chat spam", "type": "textMute", "duration": "30m", "reason": "Chat spam" },
      { "name": "Toxic chat", "type": "textMute", "duration": "2h", "reason": "Toxic behavior in chat" }
    ],
    // Manual-flow presets; the menu also adds `Custom...`.
    "reasonPresets": [
      "Cheating",
      "Toxic behavior",
      "Mic spam",
      "Team damage / griefing",
      "Inappropriate nickname"
    ],
    // Rows of the menu duration picker (same grammar as template durations).
    "menuDurations": ["5m", "30m", "1h", "1d", "7d", "perm"]
  },
  "abuseProtection": {
    // Automatic freezing only; manual freeze commands remain available.
    "enabled": true,
    // Network-wide sliding window in minutes.
    "windowMinutes": 10,
    // Per-window thresholds; reaching one freezes the admin, 0 disables that counter. Root ('z')
    // admins are exempt.
    "maxBans": 5,
    "maxKicks": 10,
    // Voice + text mutes combined.
    "maxMutes": 15,
    "maxWarnings": 15
  },
  "chat": {
    "broadcastPunishments": true,
    "tagAdminChatMessages": true,
    // Used when an admin has no group prefix. "fallbackNameColor" and "fallbackMessageColor" also
    // exist, both defaulting to "default".
    "fallbackPrefix": "[ADMIN]",
    "fallbackPrefixColor": "red"
  },
  "reports": {
    // Enables `!r` and `!report` for all players.
    "enabled": true,
    // Both in seconds, 0 disables: delay between a player's reports, then before the same
    // reporter can report the same target again.
    "cooldownSec": 120,
    "duplicateWindowSec": 1800,
    // Adds a 64-character `Other...` reason stored with code `other`.
    "allowCustomReason": true,
    // `code` is the website key; `label` is the fallback for a missing translation.
    "reasons": [
      { "code": "cheating", "label": "Cheating / aimbot" },
      { "code": "wallhack", "label": "Wallhack" },
      { "code": "griefing", "label": "Griefing / team damage" },
      { "code": "abuse", "label": "Toxic behavior" },
      { "code": "micspam", "label": "Mic spam" },
      { "code": "nickname", "label": "Inappropriate nickname" }
    ]
  },
  "cheatCheck": {
    // Delivery mode: "fixedLink" | "websiteAutoRoom" | "playerProvided".
    "mode": "fixedLink",
    // Seconds to comply before the timeout action fires.
    "timeoutSec": 120,
    // False unfreezes and notifies the admin instead of kicking.
    "autoKick": true,
    "kickReason": "Failed to comply with cheat check",
    // Move the suspect to spectator as well as freezing them.
    "moveToSpectator": true,
    // Optional https image atop the panel; empty for none. Sized by "bannerWidth"/"bannerHeight"
    // (320x180 by default).
    "bannerImageUrl": "",
    // "fixedLink" mode: the URL shown to the suspect. Also the websiteAutoRoom fallback.
    "fixedLink": {
      "url": "https://discord.gg/your-invite"
    },
    // Prefilled for the meat-app API. Another API also needs "authHeader", "authScheme",
    // "playerUrlField", "checkerUrlField" and "presenceField" - see the schema.
    "websiteAutoRoom": {
      "createRoomUrl": "http://localhost:4000/api/rooms",
      // meat-app keys are mk_... and need the JOIN_ROOM_AS_ADMIN permission.
      "apiKey": "",
      // String values may use {steamId}, {playerName}, {adminSteamId} and {adminName}.
      "requestBody": {
        "purpose": "CHEAT_CHECK",
        "title": "Cheat check: {playerName}",
        "isLocked": false,
        // Lets the backend make the calling admin the host.
        "adminSteamId": "{adminSteamId}",
        "metadata": {
          "reason": "Suspect {playerName} ({steamId}) - by {adminName}"
        }
      },
      // Shown to the suspect, then relayed to the admin; {value} is the room code.
      "playerUrlTemplate": "http://localhost:4001/rooms/{value}",
      "checkerUrlTemplate": "http://localhost:4001/rooms/{value}",
      // Polling pauses the countdown while the suspect is in the room. Empty disables it;
      // placeholders are {code} and {steamId}.
      "presenceUrl": "http://localhost:4000/api/rooms/{code}/presence?steamId={steamId}",
      // Poll cadence, and so the worst-case delay before a join is noticed.
      "pollIntervalSec": 5
    }
  },
  "maps": {
    // Maps admins may switch to; the engine has no usable list of its own. A non-zero workshopId
    // addresses a workshop map by published-file id instead of by name. Omit the list and these
    // same six apply, so the Map menu is never empty.
    "cycle": [
      { "name": "de_dust2", "displayName": "Dust II" },
      { "name": "de_mirage", "displayName": "Mirage" },
      { "name": "de_inferno", "displayName": "Inferno" },
      { "name": "de_nuke", "displayName": "Nuke" },
      { "name": "de_ancient", "displayName": "Ancient" },
      { "name": "de_anubis", "displayName": "Anubis" }
    ],
    // The yes/no vote an admin opens from Map > Put to vote.
    "vote": {
      // Share of the ballots cast that must be yes.
      "successRatio": 0.6,
      // How long the panel stays open.
      "durationSec": 20
    }
  },
  "weapons": {
    // Offered by !give and Control > Give weapon. `item` is the entity classname; anything not
    // starting with `weapon_` is skipped. Omit the list and these same twelve apply.
    "menu": [
      { "name": "AK-47", "item": "weapon_ak47" },
      { "name": "M4A4", "item": "weapon_m4a1" },
      { "name": "AWP", "item": "weapon_awp" },
      { "name": "Desert Eagle", "item": "weapon_deagle" },
      { "name": "MP9", "item": "weapon_mp9" },
      { "name": "Nova", "item": "weapon_nova" },
      { "name": "Negev", "item": "weapon_negev" },
      { "name": "Knife", "item": "weapon_knife" },
      { "name": "HE Grenade", "item": "weapon_hegrenade" },
      { "name": "Flashbang", "item": "weapon_flashbang" },
      { "name": "Smoke", "item": "weapon_smokegrenade" },
      { "name": "Molotov", "item": "weapon_molotov" }
    ]
  },
  "menu": {
    // Which menu to draw: "auto" prefers the clickable Panorama menu and falls back to center
    // HTML where the custom-UI capability is off (any non-Windows server today). "panorama" and
    // "centerHtml" pin one; a pinned "panorama" still falls back rather than showing nothing.
    "style": "auto",
    // Panorama layout to drive. A replacement must declare the same panel ids.
    "layout": "voltmod_menu",
    // Workshop addon carrying the compiled layout. 0 requires nothing of connecting clients,
    // which is what you want while copying the compiled files into your own client by hand.
    "addonId": 0
  }
}
