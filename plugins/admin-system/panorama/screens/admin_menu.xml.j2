{# namespace: AdminMenuLayout #}
{% import "menu.xml.j2" as blocks %}
{% from "admin_menu/icons.j2" import ICONS %}

<root>
  <styles>
    <include src="file://{resources}/styles/custom_game/{{screen}}.css" />
  </styles>

  {% call blocks.menu(6, 8, ICONS) -%}
  <Label class="Brand-title" text="{s:brand}" hittest="false" />
  <Label class="Brand-subtitle" text="{s:brand_subtitle}" hittest="false" />
  {%- endcall %}
</root>