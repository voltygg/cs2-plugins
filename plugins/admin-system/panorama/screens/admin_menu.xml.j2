{# namespace: AdminUi::Menu #}
{% import "button.xml.j2" as controls %}
{% import "icons.xml.j2" as icons %}
{% import "listrow.xml.j2" as list %}
{% from "admin_menu/icons.j2" import ICONS %}

{%- set ROWS = 8 %}
{%- set TABS = 6 %}

<root>
  <styles>
    <include src="file://{resources}/styles/custom_game/{{screen}}.css" />
  </styles>

  <Panel class="Layer" hittest="false">
    <Panel id="{{screen}}" class="Screen Hidden" hittest="true">
      <Panel class="Window" hittest="true">

        <Panel class="Sidebar" hittest="true">
          <Panel class="Brand" hittest="false">
            <Label class="Brand-title" text="{s:brand}" hittest="false" />
            <Label class="Brand-subtitle" text="{s:brand_sub}" hittest="false" />
          </Panel>
          <Panel class="Nav" hittest="true">
            {%- for index in range(TABS) %}
            <Button id="{{screen}}_tab{{index}}" class="Tab Hidden">
              {{ icons.icons("tab" ~ index ~ "_icon", ICONS) | indent(14) }}
              <Label class="Tab-label" text="{s:tab{{index}}}" hittest="false" />
            </Button>
            {%- endfor %}
          </Panel>
        </Panel>

        <Panel class="Content" hittest="true">
          <Panel class="Head" hittest="true">
            <Panel class="Head-text" hittest="false">
              <Label class="Crumb" text="{s:crumb}" hittest="false" />
              <Label class="Title" text="{s:title}" hittest="false" />
              <Label id="{{screen}}_subtitle" class="Subtitle" text="{s:subtitle}" hittest="false" />
            </Panel>
            <Button id="{{screen}}_close" class="IconBtn">
              <Image class="IconBtn-image" src="s2r://panorama/images/icons/ui/cancel.vsvg" textureheight="32" hittest="false" />
            </Button>
          </Panel>

          <Panel class="Rows" hittest="true">
            {%- for row in range(ROWS) %}
            {{ list.listrow("row" ~ row, switch=true, hint=true, steppers=true, chevron=true) | indent(12) }}
            {%- endfor %}
            <Label id="{{screen}}_empty" class="Empty Hidden" text="{s:empty}" hittest="false" />
          </Panel>

          <Panel id="{{screen}}_prompt" class="Prompt Hidden" hittest="true">
            <Label class="Prompt-text" text="{s:prompt_text}" hittest="false" />
            <Label class="Prompt-hint" text="{s:prompt_hint}" hittest="false" />
            {{ controls.button("cancel", "{s:cancel}") | indent(12) }}
          </Panel>

          <Panel class="Foot" hittest="true">
            {{ controls.button("back", "{s:back}") | indent(12) }}
            <Panel id="{{screen}}_page" class="Pager Hidden" hittest="true">
              <Label class="Pager-label" text="{s:page}" hittest="false" />
              <Button id="{{screen}}_page_prev" class="Pager-arrow">
                <Label class="Pager-glyph" text="&#9664;" hittest="false" />
              </Button>
              <Button id="{{screen}}_page_next" class="Pager-arrow">
                <Label class="Pager-glyph" text="&#9654;" hittest="false" />
              </Button>
            </Panel>
          </Panel>
        </Panel>

      </Panel>
    </Panel>
  </Panel>
</root>
