{% import "icons.css.j2" as icons %}
{% from "admin_menu/icons.j2" import ICONS %}

.Sidebar {
  width: 236px;
  height: 100%;
  flow-children: down;
  padding: 22px 14px;
  background-color: #0b0b0f;
  border-radius: 16px 0px 0px 16px;
}

.Brand {
  width: 100%;
  height: fit-children;
  flow-children: down;
  margin: 0px 10px 24px 10px;
}

.Brand-title {
  width: 100%;
  font-size: 20px;
  font-weight: bold;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: #ffffff;
  text-overflow: ellipsis;
}

.Brand-subtitle {
  width: 100%;
  margin-top: 2px;
  font-size: 12px;
  color: #5c5c66;
}

.Nav {
  width: 100%;
  height: fill-parent-flow(1);
  flow-children: down;
}

.Tab {
  width: 100%;
  height: 44px;
  margin-bottom: 4px;
  padding: 0px 12px;
  flow-children: right;
  border-radius: 10px;
  background-color: rgba(255, 255, 255, 0);
}

.Tab:hover {
  background-color: #1a1a21;
}

.Tab:active {
  pre-transform-scale2d: 0.98;
}

.Tab.Selected {
  background-color: gradient(linear, 0% 0%, 100% 0%, from(#e1273c), to(#8f1a29));
}

.Tab .Icons {
  width: 20px;
  height: 20px;
  vertical-align: center;
  margin-right: 12px;
}

.Tab .Icons Image {
  wash-color: #74747e;
}

.Tab:hover .Icons Image {
  wash-color: #e6e6ea;
}

.Tab.Selected .Icons Image {
  wash-color: #ffffff;
}

{{ icons.show_rules(ICONS) }}

.Tab-label {
  width: fill-parent-flow(1);
  vertical-align: center;
  font-size: 15px;
  color: #a8a8b2;
  text-overflow: ellipsis;
}

.Tab:hover .Tab-label {
  color: #f5f5f7;
}

.Tab.Selected .Tab-label {
  color: #ffffff;
  font-weight: bold;
}
