{#- Hover states switch instantly: a fade leaves two rows half-lit when the pointer moves fast. -#}
.Rows {
  width: 100%;
  height: fill-parent-flow(1);
  flow-children: down;
}

.Screen.Prompting .Rows,
.Screen.Prompting .Pager {
  opacity: 0.3;
}

.Row {
  width: 100%;
  height: 50px;
  margin-bottom: 6px;
  flow-children: right;
  background-color: #17171d;
  border-radius: 12px;
  transition-property: background-color;
  transition-duration: 0.2s;
}

/* Styling only; a disabled row still reports its press, and the driver drops it. */
.Row.Disabled {
  opacity: 0.4;
}

/* The driver clears Changed after ~150 ms; the transition is the pulse fading out. */
.Row.Changed {
  background-color: rgba(225, 39, 60, 0.22);
}

.Row-hit {
  width: fill-parent-flow(1);
  height: 100%;
  flow-children: right;
  padding: 0px 16px 0px 18px;
  border-radius: 12px;
  transition-property: pre-transform-scale2d;
  transition-duration: 0.12s;
}

.Row-hit:hover {
  background-color: gradient(linear, 0% 0%, 100% 0%, from(rgba(225, 39, 60, 0.16)), to(rgba(225, 39, 60, 0.02)));
}

.Row-hit:active {
  pre-transform-scale2d: 0.99;
}

.Row.Disabled .Row-hit:hover {
  background-color: rgba(0, 0, 0, 0);
}

.Row-body {
  width: fill-parent-flow(1);
  height: fit-children;
  flow-children: down;
  vertical-align: center;
}

.Row-label {
  width: 100%;
  font-size: 15px;
  color: #e8e8ec;
  text-overflow: ellipsis;
}

.Row-hit:hover .Row-label {
  color: #ffffff;
}

.Row-hint {
  width: 100%;
  font-size: 11px;
  color: #6a6a74;
  text-overflow: ellipsis;
  visibility: collapse;
}

.Row.HasHint .Row-hint {
  visibility: visible;
}

.Row-value {
  vertical-align: center;
  margin-left: 10px;
  padding: 4px 10px;
  border-radius: 6px;
  background-color: rgba(240, 181, 74, 0.1);
  font-size: 13px;
  color: #f0b54a;
  text-overflow: ellipsis;
  visibility: collapse;
}

.Row.HasValue .Row-value {
  visibility: visible;
}

/* The switch already says ON or OFF. */
.Row.Kind--toggle .Row-value {
  visibility: collapse;
}

/* Only rows that lead somewhere: a submenu, or a prompt for typed input. */
.Row-chevron {
  vertical-align: center;
  margin-left: 12px;
  font-size: 22px;
  color: #6a6a74;
  visibility: collapse;
}

.Kind--submenu .Row-chevron,
.Kind--input .Row-chevron {
  visibility: visible;
}

.Row-hit:hover .Row-chevron {
  color: #e1273c;
}

.Switch {
  width: 44px;
  height: 24px;
  vertical-align: center;
  margin-left: 12px;
  border-radius: 12px;
  background-color: #2c2c35;
  visibility: collapse;
}

.Kind--toggle .Switch {
  visibility: visible;
}

.Row-hit:hover .Switch {
  background-color: #3a3a44;
}

.Switch-knob {
  width: 18px;
  height: 18px;
  margin-left: 3px;
  vertical-align: center;
  border-radius: 9px;
  background-color: #a8a8b2;
  transform: translateX(0px);
  transition-property: transform;
  transition-duration: 0.15s;
  transition-timing-function: ease-out;
}

.Row.On .Switch {
  background-color: #e1273c;
}

.Row.On .Row-hit:hover .Switch {
  background-color: #f0384d;
}

.Row.On .Switch-knob {
  background-color: #ffffff;
  transform: translateX(20px);
}

.Steppers {
  width: fit-children;
  height: 100%;
  flow-children: right;
  margin-right: 10px;
  visibility: collapse;
}

.Row.HasSteppers .Steppers {
  visibility: visible;
}

.Stepper {
  width: 30px;
  height: 30px;
  margin-left: 4px;
  vertical-align: center;
  border-radius: 8px;
  background-color: #23232b;
  color: #a8a8b2;
  transition-property: pre-transform-scale2d;
  transition-duration: 0.12s;
}

.Stepper:hover {
  background-color: #e1273c;
  color: #ffffff;
}

.Stepper:active {
  pre-transform-scale2d: 0.92;
}

.Stepper-glyph {
  horizontal-align: center;
  vertical-align: center;
  font-size: 10px;
}

.Empty {
  width: 100%;
  height: 50px;
  text-align: center;
  font-size: 14px;
  color: #5c5c66;
}
