{#- Hover states switch instantly: a fade leaves two rows half-lit when the pointer moves fast. -#}
.Rows {
  width: 100%;
  height: fill-parent-flow(1);
  flow-children: down;
}

.Screen.Prompting .Rows,
.Screen.Prompting .Pager {
  opacity: 0.3;
}

.Row {
  height: 50px;
  margin-bottom: 6px;
  background-color: #1b1b23;
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 12px;
  transition-property: background-color;
  transition-duration: 0.2s;
}

/* Styling only; a disabled row still reports its press, and the driver drops it. Dimmed rather
   than faded out: a half-transparent row reads as still loading. */
.Row.Disabled {
  background-color: #17171d;
  border: 1px solid rgba(255, 255, 255, 0.04);
}

.Row.Disabled .Row-label {
  color: #5c5c66;
}

/* A stepped value waiting to apply; the transition fades it out once it has. */
.Row.Pending {
  background-color: rgba(225, 39, 60, 0.22);
}

.Row-button {
  padding: 0px 16px 0px 18px;
  border-radius: 12px;
}

.Row-button:hover {
  background-color: gradient(linear, 0% 0%, 100% 0%, from(rgba(225, 39, 60, 0.16)), to(rgba(225, 39, 60, 0.02)));
}

.Row-button:active {
  pre-transform-scale2d: 0.99;
}

.Row.Disabled .Row-button:hover,
.Row.Static .Row-button:hover {
  background-color: rgba(0, 0, 0, 0);
}

/* A heading or placeholder: the model refuses the press, so the row must not invite one. */
.Row.Static {
  background-color: rgba(0, 0, 0, 0);
  border: 0px solid rgba(0, 0, 0, 0);
}

.Row.Static .Row-button:active {
  pre-transform-scale2d: 1.0;
}

.Row.Static .Row-label,
.Row.Static .Row-button:hover .Row-label {
  color: #8a8a94;
}

.Row-label {
  font-size: 15px;
  color: #e8e8ec;
}

.Row-button:hover .Row-label {
  color: #ffffff;
}

.Row-hint {
  color: #6a6a74;
  visibility: collapse;
}

.Row.Pending .Row-hint {
  visibility: visible;
}

.Row-value {
  margin-left: 10px;
  padding: 4px 10px;
  border-radius: 6px;
  background-color: rgba(240, 181, 74, 0.1);
  color: #f0b54a;
  visibility: collapse;
}

.Row.HasValue .Row-value {
  visibility: visible;
}

/* The switch already says ON or OFF. */
.Row.Toggle .Row-value {
  visibility: collapse;
}

.Row-chevron {
  margin-left: 12px;
  font-size: 22px;
  color: #6a6a74;
}

.Row.HasChevron .Row-chevron {
  visibility: visible;
}

.Row-button:hover .Row-chevron {
  color: #e1273c;
}

.Switch {
  width: 44px;
  height: 24px;
  margin-left: 12px;
  border-radius: 12px;
  background-color: #2c2c35;
  border: 1px solid rgba(255, 255, 255, 0.10);
}

.Row.Toggle .Switch {
  visibility: visible;
}

.Row-button:hover .Switch {
  background-color: #3a3a44;
}

.Switch-knob {
  width: 18px;
  height: 18px;
  border-radius: 9px;
  background-color: #a8a8b2;
  transition-duration: 0.15s;
}

.Row.On .Switch {
  background-color: #e1273c;
  border: 1px solid #f0384d;
}

.Row.On .Row-button:hover .Switch {
  background-color: #f0384d;
}

.Row.On .Switch-knob {
  background-color: #ffffff;
  transform: translateX(20px);
}

.Steppers {
  width: fit-children;
  margin-right: 10px;
}

.Row.HasSteppers .Steppers {
  visibility: visible;
}

.Stepper {
  width: 30px;
  height: 30px;
  margin-left: 4px;
  vertical-align: center;
  border-radius: 8px;
  background-color: #2c2c37;
  color: #a8a8b2;
}

.Stepper:hover {
  background-color: #e1273c;
  color: #ffffff;
}

.Stepper:active {
  pre-transform-scale2d: 0.92;
}

.Stepper-glyph {
  font-size: 10px;
}

.Empty {
  width: 100%;
  height: 50px;
  text-align: center;
  font-size: 14px;
  color: #5c5c66;
}
