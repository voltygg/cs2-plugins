.Prompt {
  width: 100%;
  height: fit-children;
  flow-children: down;
  margin-top: 8px;
  padding: 14px;
  background-color: #1b1b23;
  border: 1px solid rgba(225, 39, 60, 0.6);
  border-radius: 12px;
}

.Prompt-text {
  width: 100%;
  font-size: 15px;
  color: #f5f5f7;
}

.Prompt-hint {
  width: 100%;
  margin-bottom: 10px;
  font-size: 13px;
  color: #f0b54a;
}

.Footer {
  width: 100%;
  height: 40px;
  flow-children: right;
  margin-top: 10px;
}

.Button {
  width: 150px;
  height: 40px;
  border-radius: 10px;
  background-color: #1b1b23;
  border: 1px solid rgba(255, 255, 255, 0.10);
}

.Button:hover {
  background-color: #2a2a35;
  border: 1px solid rgba(225, 39, 60, 0.6);
}

.Button:active {
  pre-transform-scale2d: 0.97;
}

.Button-label {
  font-size: 14px;
  color: #d8d8de;
}

.Button:hover .Button-label {
  color: #ffffff;
}

.Pager {
  width: fill-parent-flow(1);
  height: 100%;
  flow-children: right;
}

.Pager-label {
  width: fill-parent-flow(1);
  vertical-align: center;
  margin-right: 14px;
  text-align: right;
  font-size: 14px;
  color: #8a8a94;
}

.Pager-arrow {
  width: 40px;
  height: 100%;
  margin-left: 6px;
  border-radius: 10px;
  background-color: #1b1b23;
  border: 1px solid rgba(255, 255, 255, 0.10);
  color: #b4b4be;
  transition-property: pre-transform-scale2d;
  transition-duration: 0.12s;
}

.Pager-arrow:hover {
  background-color: #e1273c;
  color: #ffffff;
}

.Pager-arrow:active {
  pre-transform-scale2d: 0.94;
}

.Pager-glyph {
  horizontal-align: center;
  vertical-align: center;
  font-size: 11px;
}
