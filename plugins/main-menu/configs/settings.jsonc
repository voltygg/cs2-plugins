{
  "$schema": "./settings.schema.json",
  "plugin": {
    "locale": "ru"
  },
  "menu": {
    // Clients without the layout (addon still downloading) get the same menu in center HTML.
    "panorama": true,
    // meatgg_ui, the same addon admin-system requires; a client downloads it once.
    "addonId": 3801580041
  },
  // At most 6 tabs. A label is a translation key or literal text. `kind` is one of:
  //   command  runs a console command as the player (a legacy plugin's menu, e.g. mm_lvl for !lvl)
  //   link     prints the URL to the player's chat
  //   section  opens another VoltMod plugin's menu; hidden while that plugin is not loaded
  "tabs": [
    {
      "label": "tab.stats",
      "icon": "stats",
      "entries": [
        { "kind": "command", "label": "entry.level", "command": "mm_lvl" },
        { "kind": "command", "label": "entry.rank", "command": "mm_rank" },
        { "kind": "command", "label": "entry.top", "command": "mm_top" },
        { "kind": "command", "label": "entry.topTime", "command": "mm_toptime" },
        { "kind": "command", "label": "entry.session", "command": "mm_session" }
      ]
    },
    {
      "label": "tab.vip",
      "icon": "vip",
      "entries": [{ "kind": "command", "label": "entry.vip", "command": "mm_vip" }]
    },
    {
      "label": "tab.admin",
      "icon": "admin",
      "entries": [{ "kind": "section", "label": "entry.admin", "section": "admin" }]
    },
    {
      "label": "tab.skins",
      "icon": "skins",
      "entries": [{ "kind": "link", "label": "entry.skins", "url": "https://meat.gg/skinchanger" }]
    },
    {
      "label": "tab.clans",
      "icon": "clans",
      "entries": [{ "kind": "link", "label": "entry.clans", "url": "https://meat.gg/clans" }]
    },
    {
      "label": "tab.rules",
      "icon": "rules",
      "entries": [{ "kind": "link", "label": "entry.rules", "url": "https://meat.gg/rules" }]
    }
  ]
}
