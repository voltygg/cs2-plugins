{#- The menu block styled like the meat-app frontend. Hover switches instantly: a fade leaves two
    rows half-lit when the pointer moves fast. -#}
.screen {
  opacity: 1;
  transition-property: opacity;
  transition-duration: 0.12s;
  transition-timing-function: ease-out;
}

/* Collapse as well as fade: a transparent panel still takes clicks. */
.screen.hidden {
  opacity: 0;
}

/* Pressed buttons shrink a touch; each sets its own scale on :active. */
.button,
.tab,
.icon-button,
.row__stepper,
.pager__arrow {
  transition-property: pre-transform-scale2d;
  transition-duration: 0.12s;
}

.menu {
  background-color: gradient(linear, 0% 0%, 0% 100%, from(window-top), to(window-bottom));
  border: 1px solid hairline;
  border-radius: 16px;
  box-shadow: rgba(0, 0, 0, 0.72) 0px 0px 40px 0px;
  color: text-primary;
  transform: translateY(0px);
  transition-property: transform;
  transition-duration: 0.12s;
  transition-timing-function: ease-out;
}

.screen.hidden .menu {
  transform: translateY(10px);
}

.menu__sidebar {
  background-color: sidebar;
  border-right: 1px solid hairline;
  border-radius: 16px 0px 0px 16px;
}

/* The site's red bloom behind the page, clipped to the window's right corners. */
.menu__content {
  background-color: gradient(radial, 70% 0%, 0% 0%, 70% 55%, from(primary-glow), to(clear));
  border-radius: 0px 16px 16px 0px;
}

.screen.screen--no-sidebar .menu__content {
  border-radius: 16px;
}

.menu__brand-title {
  width: 100%;
  font-size: 20px;
  font-weight: bold;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: text-primary;
  text-overflow: ellipsis;
}

.menu__brand-subtitle {
  width: 100%;
  margin-top: 4px;
  font-size: 12px;
  color: text-secondary;
}

.tab {
  border-radius: 10px;
  background-color: clear;
  border: 1px solid clear;
}

.tab:hover {
  background-color: primary-hover;
}

.tab:active {
  pre-transform-scale2d: 0.98;
}

.tab.tab--selected {
  background-color: primary-active;
  border: 1px solid primary-edge;
}

.tab .icon-set__icon {
  wash-color: text-secondary;
}

.tab:hover .icon-set__icon {
  wash-color: text-primary;
}

.tab.tab--selected .icon-set__icon {
  wash-color: primary;
}

.tab__label {
  color: text-primary;
}

.tab.tab--selected .tab__label {
  font-weight: bold;
}

/* Tracked micro-caps above a title. */
.menu__breadcrumb,
.overline {
  font-size: 11px;
  font-weight: bold;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.menu__breadcrumb {
  color: text-disabled;
}

.menu__title {
  font-size: 26px;
  letter-spacing: -0.5px;
  color: text-primary;
}

.menu__subtitle {
  color: text-secondary;
}

.icon-button {
  border-radius: 10px;
  background-color: fill;
  border: 1px solid hairline;
}

.icon-button:hover {
  background-color: primary-selected;
  border: 1px solid primary-line;
}

.icon-button:active {
  pre-transform-scale2d: 0.94;
}

.icon-button__image {
  wash-color: text-secondary;
}

.icon-button:hover .icon-button__image {
  wash-color: text-primary;
}

.screen.screen--prompting .menu__rows,
.screen.screen--prompting .pager {
  opacity: 0.3;
}

/* The button is the row's card, so its hover can light the edge too; steppers sit beside it. */
.row {
  height: 48px;
}

.row__button {
  border-radius: 10px;
  background-color: fill-subtle;
  border: 1px solid hairline;
  /* Also fades the pending-value highlight out once it applies. */
  transition-property: pre-transform-scale2d, background-color;
  transition-duration: 0.12s, 0.2s;
}

.row__button:hover {
  background-color: primary-hover;
  border: 1px solid primary-edge;
}

.row__button:active {
  pre-transform-scale2d: 0.99;
}

/* Styling only; a disabled row still reports its press, and the driver drops it. Dimmed rather
   than faded out: a half-transparent row reads as still loading. */
.row.row--disabled .row__button,
.row.row--disabled .row__button:hover {
  background-color: clear;
  border: 1px solid hairline-faint;
}

.row.row--disabled .row__label {
  color: text-disabled;
}

/* A stepped value waiting to apply; the transition fades it out once it has. */
.row.row--pending .row__button {
  background-color: primary-selected;
  border: 1px solid primary-edge;
}

/* A heading or placeholder: the model refuses the press, so the row must not invite one. */
.row.row--static .row__button,
.row.row--static .row__button:hover {
  background-color: clear;
  border: 1px solid clear;
}

.row.row--static .row__button:active {
  pre-transform-scale2d: 1.0;
}

.row.row--static .row__label {
  color: text-secondary;
}

.row__label {
  color: text-primary;
}

.row__hint {
  color: text-secondary;
}

.row__value {
  border-radius: 6px;
  background-color: secondary-tint;
  color: secondary;
  font-weight: bold;
}

.row__chevron {
  margin-bottom: 3px;
  font-size: 24px;
  color: text-disabled;
}

.row__button:hover .row__chevron {
  color: primary;
}

.switch {
  border-radius: 12px;
  background-color: fill;
  border: 1px solid hairline-strong;
}

.switch__knob {
  border-radius: 9px;
  background-color: text-secondary;
  transition-duration: 0.15s;
}

.row.row--on .switch {
  background-color: primary;
  border: 1px solid primary-light;
}

.row.row--on .switch__knob {
  background-color: #ffffff;
}

.row__steppers {
  margin-left: 6px;
  margin-right: 0px;
}

.row__stepper {
  width: 34px;
  height: 100%;
  border-radius: 10px;
  background-color: fill-subtle;
  border: 1px solid hairline;
  color: text-secondary;
}

.row__stepper:hover {
  background-color: primary-selected;
  border: 1px solid primary-line;
  color: text-primary;
}

.row__stepper:active {
  pre-transform-scale2d: 0.92;
}

.menu__empty {
  color: text-secondary;
}

.menu__prompt {
  background-color: fill-subtle;
  border: 1px solid primary-line;
  border-radius: 12px;
}

.menu__prompt-text {
  color: text-primary;
}

.menu__prompt-hint {
  color: secondary;
}

/* The site's outlined button: a quiet fill that picks up the red edge on hover. */
.button {
  width: 140px;
  border-radius: 10px;
  background-color: fill-subtle;
  border: 1px solid hairline-strong;
}

.button:hover {
  background-color: primary-hover;
  border: 1px solid primary-line;
}

.button:active {
  pre-transform-scale2d: 0.97;
}

.button__label {
  font-weight: bold;
  color: text-primary;
}

.pager__label {
  color: text-secondary;
}

.pager__arrow {
  border-radius: 10px;
  background-color: fill-subtle;
  border: 1px solid hairline-strong;
  color: text-secondary;
}

.pager__arrow:hover {
  background-color: primary-selected;
  border: 1px solid primary-line;
  color: text-primary;
}

.pager__arrow:active {
  pre-transform-scale2d: 0.94;
}

/* The site's contained primary button, for a screen's main action. */
.button--primary {
  background-color: primary;
  border: 1px solid primary;
  box-shadow: rgba(225, 39, 60, 0.2) 0px 3px 8px 0px;
}

.button--primary:hover {
  background-color: primary-light;
  border: 1px solid primary-light;
}

.button--primary .button__label {
  color: #ffffff;
}
