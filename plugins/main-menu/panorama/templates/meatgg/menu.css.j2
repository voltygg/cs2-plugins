{#- The menu block styled like the meat-app frontend. Hover switches instantly: a fade leaves two
    rows half-lit when the pointer moves fast. -#}
.Screen {
  opacity: 1;
  transition-property: opacity;
  transition-duration: 0.12s;
  transition-timing-function: ease-out;
}

/* Collapse as well as fade: a transparent panel still takes clicks. */
.Screen.Hidden {
  opacity: 0;
}

/* Pressed buttons shrink a touch; each sets its own scale on :active. */
.Button,
.Tab,
.IconButton,
.Row-button,
.Stepper,
.Pager-arrow {
  transition-property: pre-transform-scale2d;
  transition-duration: 0.12s;
}

.Window {
  background-color: gradient(linear, 0% 0%, 0% 100%, from(window-top), to(window-bottom));
  border: 1px solid hairline;
  border-radius: 16px;
  box-shadow: rgba(0, 0, 0, 0.72) 0px 0px 40px 0px;
  color: text-primary;
  transform: translateY(0px);
  transition-property: transform;
  transition-duration: 0.12s;
  transition-timing-function: ease-out;
}

.Screen.Hidden .Window {
  transform: translateY(10px);
}

.Sidebar {
  background-color: sidebar;
  border-right: 1px solid hairline;
  border-radius: 16px 0px 0px 16px;
}

/* The site's red bloom behind the page, clipped to the window's right corners. */
.Content {
  background-color: gradient(radial, 70% 0%, 0% 0%, 70% 55%, from(primary-glow), to(clear));
  border-radius: 0px 16px 16px 0px;
}

.Screen.NoSidebar .Content {
  border-radius: 16px;
}

.Brand-title {
  width: 100%;
  font-size: 20px;
  font-weight: bold;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: text-primary;
  text-overflow: ellipsis;
}

.Brand-subtitle {
  width: 100%;
  margin-top: 4px;
  font-size: 12px;
  color: text-secondary;
}

.Tab {
  border-radius: 10px;
  background-color: clear;
  border: 1px solid clear;
}

.Tab:hover {
  background-color: primary-hover;
}

.Tab:active {
  pre-transform-scale2d: 0.98;
}

.Tab.Selected {
  background-color: primary-active;
  border: 1px solid primary-edge;
}

.Tab .Icons Image {
  wash-color: text-secondary;
}

.Tab:hover .Icons Image {
  wash-color: text-primary;
}

.Tab.Selected .Icons Image {
  wash-color: primary;
}

.Tab-label {
  color: text-primary;
}

.Tab.Selected .Tab-label {
  font-weight: bold;
}

/* Tracked micro-caps, the site's section eyebrow. */
.Breadcrumb {
  font-size: 11px;
  font-weight: bold;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: text-disabled;
}

.Title {
  font-size: 26px;
  letter-spacing: -0.5px;
  color: text-primary;
}

.Subtitle {
  color: text-secondary;
}

.IconButton {
  border-radius: 10px;
  background-color: fill;
  border: 1px solid hairline;
}

.IconButton:hover {
  background-color: primary-selected;
  border: 1px solid primary-line;
}

.IconButton:active {
  pre-transform-scale2d: 0.94;
}

.IconButton-image {
  wash-color: text-secondary;
}

.IconButton:hover .IconButton-image {
  wash-color: text-primary;
}

.Screen.Prompting .Rows,
.Screen.Prompting .Pager {
  opacity: 0.3;
}

/* The button is the row's card, so its hover can light the edge too; steppers sit beside it. */
.Row {
  height: 48px;
}

.Row-button {
  padding: 0px 16px 0px 18px;
  border-radius: 10px;
  background-color: fill-subtle;
  border: 1px solid hairline;
  transition-property: pre-transform-scale2d, background-color;
  transition-duration: 0.12s, 0.2s;
}

.Row-button:hover {
  background-color: primary-hover;
  border: 1px solid primary-edge;
}

.Row-button:active {
  pre-transform-scale2d: 0.99;
}

/* Styling only; a disabled row still reports its press, and the driver drops it. Dimmed rather
   than faded out: a half-transparent row reads as still loading. */
.Row.Disabled .Row-button,
.Row.Disabled .Row-button:hover {
  background-color: clear;
  border: 1px solid hairline-faint;
}

.Row.Disabled .Row-label {
  color: text-disabled;
}

/* A stepped value waiting to apply; the transition fades it out once it has. */
.Row.Pending .Row-button {
  background-color: primary-selected;
  border: 1px solid primary-edge;
}

/* A heading or placeholder: the model refuses the press, so the row must not invite one. */
.Row.Static .Row-button,
.Row.Static .Row-button:hover {
  background-color: clear;
  border: 1px solid clear;
}

.Row.Static .Row-button:active {
  pre-transform-scale2d: 1.0;
}

.Row.Static .Row-label,
.Row.Static .Row-button:hover .Row-label {
  color: text-secondary;
}

.Row-label {
  color: text-primary;
}

.Row-button:hover .Row-label {
  color: #ffffff;
}

.Row-hint {
  color: text-secondary;
}

.Row-value {
  border-radius: 6px;
  background-color: secondary-tint;
  color: secondary;
  font-weight: bold;
}

.Row-chevron {
  margin-bottom: 3px;
  font-size: 24px;
  color: text-disabled;
}

.Row-button:hover .Row-chevron {
  color: primary;
}

.Switch {
  border-radius: 12px;
  background-color: fill;
  border: 1px solid hairline-strong;
}

.Switch-knob {
  border-radius: 9px;
  background-color: text-secondary;
  transition-duration: 0.15s;
}

.Row.On .Switch {
  background-color: primary;
  border: 1px solid primary-light;
}

.Row.On .Switch-knob {
  background-color: #ffffff;
}

.Steppers {
  margin-left: 6px;
  margin-right: 0px;
}

.Stepper {
  width: 34px;
  height: 100%;
  border-radius: 10px;
  background-color: fill-subtle;
  border: 1px solid hairline;
  color: text-secondary;
}

.Stepper:hover {
  background-color: primary-selected;
  border: 1px solid primary-line;
  color: text-primary;
}

.Stepper:active {
  pre-transform-scale2d: 0.92;
}

.Empty {
  color: text-secondary;
}

.Prompt {
  background-color: fill-subtle;
  border: 1px solid primary-line;
  border-radius: 12px;
}

.Prompt-text {
  color: text-primary;
}

.Prompt-hint {
  color: secondary;
}

/* The site's outlined button: a quiet fill that picks up the red edge on hover. */
.Button {
  width: 140px;
  border-radius: 10px;
  background-color: fill-subtle;
  border: 1px solid hairline-strong;
}

.Button:hover {
  background-color: primary-hover;
  border: 1px solid primary-line;
}

.Button:active {
  pre-transform-scale2d: 0.97;
}

.Button-label {
  font-weight: bold;
  color: text-primary;
}

.Button:hover .Button-label {
  color: #ffffff;
}

.Pager-label {
  color: text-secondary;
}

.Pager-arrow {
  border-radius: 10px;
  background-color: fill-subtle;
  border: 1px solid hairline-strong;
  color: text-secondary;
}

.Pager-arrow:hover {
  background-color: primary-selected;
  border: 1px solid primary-line;
  color: text-primary;
}

.Pager-arrow:active {
  pre-transform-scale2d: 0.94;
}

/* The site's contained primary button, for a screen's main action. */
.Button-primary {
  background-color: primary;
  border: 1px solid primary;
  box-shadow: rgba(225, 39, 60, 0.2) 0px 3px 8px 0px;
}

.Button-primary:hover {
  background-color: primary-light;
  border: 1px solid primary-light;
}

.Button-primary .Button-label,
.Button-primary:hover .Button-label {
  color: #ffffff;
}
