{#- Hover has no transition on purpose: with a fade, a quick mouse move leaves two rows highlighted. -#}
{% include "@main-menu/meatgg/controls.css.j2" %}

.screen {
  opacity: 1;
  transition-property: opacity;
  transition-duration: 0.12s;
  transition-timing-function: ease-out;
}

/* Collapse the screen as well as fading it, because a transparent panel still catches clicks. */
.screen.hidden {
  opacity: 0;
}

.tab,
.row__stepper {
  transition-property: pre-transform-scale2d;
  transition-duration: 0.12s;
}

.menu {
  color: text-primary;
  transform: translateY(0px);
  transition-property: transform;
  transition-duration: 0.12s;
  transition-timing-function: ease-out;
}

.screen.hidden .menu {
  transform: translateY(10px);
}

.menu__sidebar {
  background-color: sidebar;
  border-right: 1px solid hairline;
  border-radius: 16px 0px 0px 16px;
}

.menu__content {
  background-color: gradient(radial, 70% 0%, 0% 0%, 70% 55%, from(primary-glow), to(clear));
  border-radius: 0px 16px 16px 0px;
}

.screen.screen--no-sidebar .menu__content {
  border-radius: 16px;
}

.menu__brand-title {
  width: 100%;
  font-size: 20px;
  font-weight: bold;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: text-primary;
  text-overflow: ellipsis;
}

.menu__brand-subtitle {
  width: 100%;
  margin-top: 4px;
  font-size: 12px;
  color: text-secondary;
}

.tab {
  border-radius: 10px;
  background-color: clear;
  border: 1px solid clear;
}

.tab:hover {
  background-color: primary-hover;
}

.tab:active {
  pre-transform-scale2d: 0.98;
}

.tab.tab--selected {
  background-color: primary-active;
  border: 1px solid primary-edge;
}

.tab .icon-set__icon {
  wash-color: text-secondary;
}

.tab:hover .icon-set__icon {
  wash-color: text-primary;
}

.tab.tab--selected .icon-set__icon {
  wash-color: primary;
}

.tab__label {
  color: text-primary;
}

.tab.tab--selected .tab__label {
  font-weight: bold;
}

.overline {
  font-size: 11px;
}

.menu__breadcrumb,
.overline {
  font-weight: bold;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.menu__breadcrumb {
  color: text-disabled;
}

.menu__title {
  letter-spacing: -0.5px;
  color: text-primary;
}

.menu__subtitle {
  color: text-secondary;
}

.screen.screen--prompting .menu__rows,
.screen.screen--prompting .pager {
  opacity: 0.3;
}

.row__button {
  border-radius: 10px;
  background-color: fill-subtle;
  border: 1px solid hairline;
  /* The background transition also fades out the pending highlight. */
  transition-property: pre-transform-scale2d, background-color;
  transition-duration: 0.12s, 0.2s;
}

.row__button:hover {
  background-color: primary-hover;
  border: 1px solid primary-edge;
}

.row__button:active {
  pre-transform-scale2d: 0.99;
}

/* Disabled rows are dimmed rather than made transparent, which would look like loading. */
.row.row--disabled .row__button,
.row.row--disabled .row__button:hover {
  background-color: clear;
  border: 1px solid hairline-faint;
}

.row.row--disabled .row__label {
  color: text-disabled;
}

/* A row whose new value is still being applied. */
.row.row--pending .row__button {
  background-color: primary-selected;
  border: 1px solid primary-edge;
}

/* Headings and placeholders can't be pressed, so they get no hover effect. */
.row.row--static .row__button,
.row.row--static .row__button:hover {
  background-color: clear;
  border: 1px solid clear;
}

.row.row--static .row__button:active {
  pre-transform-scale2d: 1.0;
}

.row.row--static .row__label {
  color: text-secondary;
}

.row__label {
  color: text-primary;
}

.row__hint {
  color: text-secondary;
}

.row__value {
  border-radius: 6px;
  background-color: secondary-tint;
  color: secondary;
  font-weight: bold;
}

.row__chevron {
  color: text-disabled;
}

.row__button:hover .row__chevron {
  color: primary;
}

.switch {
  border-radius: 12px;
  background-color: fill;
  border: 1px solid hairline-strong;
}

.switch__knob {
  border-radius: 9px;
  background-color: text-secondary;
  transition-property: transform;
  transition-duration: 0.15s;
  transition-timing-function: ease-out;
}

.row.row--on .switch {
  background-color: primary;
  border: 1px solid primary-light;
}

.row.row--on .switch__knob {
  background-color: #ffffff;
}

.row__stepper {
  border-radius: 10px;
  background-color: fill-subtle;
  border: 1px solid hairline;
  color: text-secondary;
}

.row__stepper:hover {
  background-color: primary-selected;
  border: 1px solid primary-line;
  color: text-primary;
}

.row__stepper:active {
  pre-transform-scale2d: 0.92;
}

.menu__empty {
  color: text-secondary;
}

.menu__prompt {
  background-color: fill-subtle;
  border: 1px solid primary-line;
  border-radius: 12px;
}

.menu__prompt-text {
  color: text-primary;
}

.menu__prompt-hint {
  color: secondary;
}

.pager__label {
  color: text-secondary;
}
