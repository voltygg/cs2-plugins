{#- The meat-app color palette as `@define` tokens. A define only works in the stylesheet that
    declares it, so every screen includes this file first. -#}
@define window-top: #12121a;
@define window-bottom: #0b0b0f;
@define card-top: #101015;
@define sidebar: #0a0a0e;

@define hairline: rgba(240, 221, 180, 0.09);
@define hairline-strong: rgba(240, 221, 180, 0.14);
@define hairline-faint: rgba(240, 221, 180, 0.04);
@define fill-subtle: rgba(240, 221, 180, 0.03);
@define fill: rgba(240, 221, 180, 0.05);
@define clear: rgba(0, 0, 0, 0);

@define primary: #e1273c;
@define primary-light: #ff4a5c;
@define primary-hover: rgba(225, 39, 60, 0.08);
@define primary-selected: rgba(225, 39, 60, 0.12);
@define primary-active: rgba(225, 39, 60, 0.14);
@define primary-edge: rgba(225, 39, 60, 0.3);
@define primary-line: rgba(225, 39, 60, 0.4);
@define primary-glow: rgba(225, 39, 60, 0.12);

@define secondary: #e0a040;
@define secondary-tint: rgba(224, 160, 64, 0.1);

@define text-primary: #f7f4ee;
@define text-secondary: #9a9aa4;
@define text-disabled: #5e5e68;
