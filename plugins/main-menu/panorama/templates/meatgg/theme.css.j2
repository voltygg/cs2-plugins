{#- meat.gg colours as Panorama `@define` tokens. A define reaches only its own stylesheet, so every
    screen includes this at the top of its CSS. -#}
@define window: #111116;
@define sidebar: #0b0b0f;
@define surface: #1b1b23;
@define surface-hover: #2a2a35;
@define surface-disabled: #17171d;
@define control: #2c2c35;
@define line: rgba(255, 255, 255, 0.10);
@define line-faint: rgba(255, 255, 255, 0.04);

@define accent: #e1273c;
@define accent-hover: #f0384d;
@define accent-deep: #8f1a29;
@define accent-line: rgba(225, 39, 60, 0.6);
@define accent-pending: rgba(225, 39, 60, 0.22);

@define text-bright: #f5f5f7;
@define text-row: #e8e8ec;
@define text-soft: #a8a8b2;
@define text-muted: #8a8a94;
@define text-faint: #6a6a74;
@define text-dim: #5c5c66;
@define gold: #f0b54a;
