{#- Colors and hover states for meat.gg windows and buttons. Include it after theme.css.j2. -#}
/* Screens that don't use the menu block draw a `.window` instead. */
.menu,
.window {
  background-color: gradient(linear, 0% 0%, 0% 100%, from(window-top), to(window-bottom));
  border: 1px solid hairline;
  border-radius: 16px;
  box-shadow: rgba(0, 0, 0, 0.72) 0px 0px 40px 0px;
}

.button {
  border-radius: 10px;
  background-color: fill-subtle;
  border: 1px solid hairline-strong;
  transition-property: pre-transform-scale2d;
  transition-duration: 0.12s;
}

.button:hover {
  background-color: primary-hover;
  border: 1px solid primary-line;
}

.button:active {
  pre-transform-scale2d: 0.97;
}

.button__label {
  font-weight: bold;
  color: text-primary;
}

.button--primary {
  background-color: primary;
  border: 1px solid primary;
  box-shadow: rgba(225, 39, 60, 0.2) 0px 3px 8px 0px;
}

.button--primary:hover {
  background-color: primary-light;
  border: 1px solid primary-light;
}

.button--primary .button__label {
  color: #ffffff;
}

.icon-button {
  border-radius: 10px;
  background-color: fill;
  border: 1px solid hairline;
  transition-property: pre-transform-scale2d;
  transition-duration: 0.12s;
}

.icon-button:hover {
  background-color: primary-selected;
  border: 1px solid primary-line;
}

.icon-button:active {
  pre-transform-scale2d: 0.94;
}

.icon-button__image {
  wash-color: text-secondary;
}

.icon-button:hover .icon-button__image {
  wash-color: text-primary;
}

.pager__arrow {
  border-radius: 10px;
  background-color: fill-subtle;
  border: 1px solid hairline-strong;
  color: text-secondary;
  transition-property: pre-transform-scale2d;
  transition-duration: 0.12s;
}

.pager__arrow:hover {
  background-color: primary-selected;
  border: 1px solid primary-line;
  color: text-primary;
}

.pager__arrow:active {
  pre-transform-scale2d: 0.94;
}
