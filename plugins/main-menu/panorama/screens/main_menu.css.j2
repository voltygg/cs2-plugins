{% import "@main-menu/meatgg/menu_screen.css.j2" as meatgg %}
{% from "main_menu/icons.j2" import ICONS %}
{{ meatgg.menu_styles(ICONS) }}

.Wordmark {
  width: 100%;
  height: 36px;
  flow-children: right;
}

.Wordmark-mark {
  width: 36px;
  height: 36px;
  margin-right: 10px;
}

.Wordmark-meat,
.Wordmark-gg {
  vertical-align: center;
  font-size: 22px;
  font-weight: black;
  letter-spacing: -1px;
}

.Wordmark-meat {
  color: text-primary;
}

.Wordmark-gg {
  color: primary;
}

.Hero {
  width: 100%;
  height: fit-children;
  flow-children: right;
  padding: 24px;
  border-radius: 14px;
  background-color: gradient(linear, 0% 0%, 0% 100%, from(card-top), to(window-bottom));
  border: 1px solid hairline;
}

.Hero-mark {
  width: 72px;
  height: 72px;
  margin-right: 20px;
  vertical-align: center;
}

.Hero-text {
  width: fill-parent-flow(1);
  height: fit-children;
  flow-children: down;
  vertical-align: center;
}

.Hero-overline {
  color: primary;
}

.Hero-title {
  width: 100%;
  margin-top: 6px;
  font-size: 22px;
  font-weight: bold;
  letter-spacing: -0.3px;
  color: text-primary;
}

.Hero-body {
  width: 100%;
  margin-top: 8px;
  font-size: 14px;
  color: text-secondary;
}

.Home-actions {
  width: 100%;
  height: fit-children;
  flow-children: right;
  margin-top: 16px;
}

.Home-actions .Button {
  width: fit-children;
  height: 44px;
  padding: 0px 24px;
}
