{# namespace: MainMenuLayout #}
{% import "menu.xml.j2" as blocks %}
{% import "button.xml.j2" as controls %}
{% import "@main-menu/meatgg/home.xml.j2" as meatgg %}
{% from "main_menu/icons.j2" import ICONS %}

{#- Shown in place of the rows on the home page; the rows repeat the sidebar there. -#}
{% set home %}
{{ meatgg.hero("Counter-Strike 2", mark=true) }}
<Panel class="home-actions" hittest="true">
  {{ controls.button("report", "{s:home_report}", "primary") | indent(2) }}
</Panel>
{% endset %}

<root>
  <styles>
    <include src="file://{resources}/styles/custom_game/{{screen}}.css" />
  </styles>

  {% call blocks.menu(7, 8, ICONS, home) -%}
  <Panel class="wordmark" hittest="false">
    <Image class="wordmark__mark" src="s2r://panorama/images/custom_game/brand/mark.vtex" hittest="false" />
    <Label class="wordmark__meat" text="MEAT" hittest="false" />
    <Label class="wordmark__gg" text=".GG" hittest="false" />
  </Panel>
  <Label class="menu__brand-subtitle" text="{s:brand_subtitle}" hittest="false" />
  {%- endcall %}
</root>
