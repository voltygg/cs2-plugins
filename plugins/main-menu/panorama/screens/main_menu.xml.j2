{# namespace: MainMenuLayout #}
{% import "menu.xml.j2" as blocks %}
{% import "button.xml.j2" as controls %}
{% from "main_menu/icons.j2" import ICONS %}

{#- Shown in place of the rows on the home page; the rows repeat the sidebar there. -#}
{% set home %}
<Panel class="Hero" hittest="false">
  <Image class="Hero-mark" src="s2r://panorama/images/custom_game/brand/mark.vtex" hittest="false" />
  <Panel class="Hero-text" hittest="false">
    <Label class="Overline Hero-overline" text="Counter-Strike 2" hittest="false" />
    <Label class="Hero-title" text="{s:home_title}" hittest="false" />
    <Label class="Hero-body" text="{s:home_body}" hittest="false" />
  </Panel>
</Panel>
<Panel class="Home-actions" hittest="true">
  {{ controls.button("report", "{s:home_report}", "primary") | indent(2) }}
</Panel>
{% endset %}

<root>
  <styles>
    <include src="file://{resources}/styles/custom_game/{{screen}}.css" />
  </styles>

  {% call blocks.menu(6, 8, ICONS, home) -%}
  <Panel class="Wordmark" hittest="false">
    <Image class="Wordmark-mark" src="s2r://panorama/images/custom_game/brand/mark.vtex" hittest="false" />
    <Label class="Wordmark-meat" text="MEAT" hittest="false" />
    <Label class="Wordmark-gg" text=".GG" hittest="false" />
  </Panel>
  <Label class="Brand-subtitle" text="{s:brand_subtitle}" hittest="false" />
  {%- endcall %}
</root>
