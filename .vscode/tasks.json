{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (Docker)",
      "type": "shell",
      "command": "docker compose run --rm build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build (Windows)",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "if not exist objdir mkdir objdir && cd objdir && uv run python ../configure.py && uv run ambuild"
      ],
      "group": "build",
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Clean Build",
      "type": "shell",
      "command": "cmd",
      "args": ["/c", "if exist objdir rmdir /s /q objdir"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "Generate VS Project",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "if not exist objdir mkdir objdir && cd objdir && uv run python ../configure.py --gen=vs --vs-version 19"
      ],
      "problemMatcher": []
    },
    {
      "label": "Start PostgreSQL",
      "type": "shell",
      "command": "docker compose up -d postgres",
      "problemMatcher": []
    },
    {
      "label": "Stop PostgreSQL",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    },
    {
      "label": "View PostgreSQL Logs",
      "type": "shell",
      "command": "docker compose logs -f postgres",
      "problemMatcher": []
    },
    {
      "label": "Start CS2 Server",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "deploy.tools.cli",
        "start"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    }
  ]
}
