{
  "configurations": [
    {
      "name": "Win32",
      "includePath": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/sdk/**",
        "${workspaceFolder}/metamod/core",
        "${workspaceFolder}/metamod/core/sourcehook",
        "${env:HL2SDKCS2}/**",
        "${env:MMSOURCE112}/core",
        "${env:MMSOURCE112}/core/sourcehook",
        "${env:VCPKG_ROOT}/installed/x64-windows/include"
      ],
      "defines": [
        "_DEBUG",
        "WIN32",
        "_WINDOWS",
        "NOMINMAX",
        "META_IS_SOURCE2",
        "COMPILER_MSVC64"
      ],
      "windowsSdkVersion": "10.0.22621.0",
      "compilerPath": "cl.exe",
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "windows-msvc-x64"
    },
    {
      "name": "Linux",
      "includePath": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/sdk/**",
        "${workspaceFolder}/metamod/core",
        "${workspaceFolder}/metamod/core/sourcehook",
        "/sdk/hl2sdk-cs2/**",
        "/sdk/metamod-source/core",
        "/sdk/metamod-source/core/sourcehook",
        "/usr/include"
      ],
      "defines": [
        "LINUX",
        "_LINUX",
        "POSIX",
        "_POSIX",
        "META_IS_SOURCE2",
        "COMPILER_GCC"
      ],
      "compilerPath": "/usr/bin/clang++",
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "linux-clang-x64"
    }
  ],
  "version": 4
}
