[Unit]
Description=CS2 Dedicated Server (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=steam
Group=steam
WorkingDirectory=/home/steam/cs2/game/bin/linuxsteamrt64
# The launch wrapper sources /home/steam/cs2/instances/%i.env and omits empty
# GSLT/RCON args (empty GSLT => LAN-only). One systemd instance per CS2 server.
ExecStart=/home/steam/cs2/cs2-launch.sh %i
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
