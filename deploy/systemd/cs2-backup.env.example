# Example /etc/cs2-backup.env — install ONLY on the box that should dump the shared
# databases (root-owned, chmod 600). Without it, cs2-backup.sh backs up configs only.
PGHOST=db.internal.example
PGPORT=5432
PGUSER=cs2_app
PGPASSWORD=change-me
# Space-separated plugin DBs to dump (match inventory.yml plugins.<name>.database).
CS2_DATABASES=admin_system
