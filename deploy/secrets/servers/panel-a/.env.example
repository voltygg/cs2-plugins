# CI: store this file's contents in the environment's SERVER_ENV secret.

# Pterodactyl client API key (panel -> Account -> API Credentials).
PANEL_API_KEY=

DB_HOST=
DB_PASSWORD=

# Optional cheatCheck.websiteAutoRoom API key.
CHEAT_API_KEY=

# The RCON password from the panel's Startup tab; empty skips the plugin load check.
RCON_PASSWORD=
