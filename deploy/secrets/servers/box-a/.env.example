# Per-server config for box-a - one unified file holding non-secret values AND secrets.
# Usage:
#   cp deploy/secrets/servers/box-a/.env.example deploy/secrets/servers/box-a/.env
#   # fill in real values (.env is gitignored)
#   sops --filename-override deploy/secrets/servers/box-a/.sops.env \
#     -e deploy/secrets/servers/box-a/.env > deploy/secrets/servers/box-a/.sops.env
#   rm deploy/secrets/servers/box-a/.env
# render.py / deploy.sh decrypt .sops.env at deploy time. For LOCAL dev
# you may keep a plaintext .env (gitignored) and skip encryption.

# --- Database (shared instance; only the password is per-server) ---
DB_PASSWORD=change-me

# --- cheatCheck.websiteAutoRoom (only if this box uses that mode; else leave blank) ---
CHEAT_ROOM_URL=
CHEAT_API_KEY=

# --- Per-instance Steam GSLT tokens + RCON passwords ---
# One pair per instance name in inventory.yml (main, retake, ...). Empty GSLT => LAN-only.
GSLT_main=
RCON_main=change-me
CS2_HOSTNAME_main=CS2 Main
GSLT_retake=
RCON_retake=change-me
CS2_HOSTNAME_retake=CS2 Retake
