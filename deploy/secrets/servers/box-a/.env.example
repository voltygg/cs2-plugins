# Per-server config + secrets for box-a.
#   CI:    paste filled-in contents into the SERVER_ENV secret on the GitHub
#          Environment named by this server's `environment:` in inventory.yml.
#   Local: copy to .env (gitignored) in this dir and fill it in.

# --- SSH parameters ---
# Path to the private key for SSH to this box
SSH_KEY_FILE=~/.ssh/id_deploy

# --- Database (shared instance; only the password is per-server) ---
DB_PASSWORD=change-me

# Postgres admin/superuser password
# only used when provisioning the shared DB, not by the plugin itself
PGPASSWORD=

# --- cheatCheck.websiteAutoRoom (only if this box uses that mode; else leave blank) ---
CHEAT_API_KEY=

# --- Per-instance Steam GSLT tokens + RCON passwords ---
# One pair per instance name in inventory.yml (main, retake, ...). Empty GSLT => LAN-only.
GSLT_main=
RCON_main=change-me
CS2_HOSTNAME_main="CS2 Main"
GSLT_retake=
RCON_retake=change-me
CS2_HOSTNAME_retake="CS2 Retake"
