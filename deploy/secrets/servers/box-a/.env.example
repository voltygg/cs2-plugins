# For CI, store this file's contents in the server environment's `SERVER_ENV`
# secret. For local use, copy it to the gitignored `.env` beside this file.

# SSH private key path.
SSH_KEY_FILE=~/.ssh/id_deploy

# Shared database password.
DB_PASSWORD=change-me

# PostgreSQL administrator password, used only for provisioning.
PGPASSWORD=

# Optional cheatCheck.websiteAutoRoom API key.
CHEAT_API_KEY=

# One GSLT/RCON pair per instance. Empty GSLT means LAN-only.
GSLT_main=
RCON_main=change-me
CS2_HOSTNAME_main="CS2 Main"
GSLT_retake=
RCON_retake=change-me
CS2_HOSTNAME_retake="CS2 Retake"
