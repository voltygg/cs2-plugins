# Per-server config for box-a — one unified file holding non-secret values AND secrets.
# Usage:
#   cp .env.example .env          # fill in real values (.env is gitignored)
#   sops -e .env > .sops.env      # encrypt; commit .sops.env (uses ../../.sops.yaml)
#   rm .env                       # never commit the plaintext
# render-config.sh / deploy-remote.sh decrypt .sops.env at deploy time. For LOCAL dev
# you may keep a plaintext .env (gitignored) and skip encryption.

# --- Database (shared instance; only the password is per-server) ---
DB_PASSWORD=change-me

# --- cheatCheck.websiteAutoRoom (only if this box uses that mode; else leave blank) ---
CHEAT_ROOM_URL=
CHEAT_API_KEY=

# --- Per-instance Steam GSLT tokens + RCON passwords ---
# One pair per instance name in inventory.yml (main, retake, ...). Empty GSLT => LAN-only.
GSLT_main=
RCON_main=change-me
GSLT_retake=
RCON_retake=change-me
