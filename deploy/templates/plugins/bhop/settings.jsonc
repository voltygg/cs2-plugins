// Shared bhop settings; this plugin has no per-instance placeholders.
{
  "plugin": {
    "locale": "ru"
  },

  "bhop": {
    // `enabled` is server-wide. `grants` uses session grants from admin-system.
    "mode": "grants",

    // sv_autobunnyhopping - hold jump to hop automatically.
    "autoBunnyhopping": true,
    // sv_enablebunnyhopping - remove the landing speed clamp (keeps gained speed).
    "enableBunnyhopping": true,

    // Stamina costs (jump-height/speed loss after landing). -1 = leave server value untouched.
    "staminaJumpCost": 0.0,
    "staminaLandCost": 0.0,

    // Air acceleration - speed gain while airborne (replicated, client-predicted).
    // sv_airaccelerate (game default 12); -1 = untouched.
    "airAccelerate": 150.0,
    // sv_air_max_wishspeed (game default 30); -1 = untouched.
    "airMaxWishSpeed": 60.0,
    // sv_maxvelocity; -1 = untouched.
    "maxVelocity": -1,

    // Optional server-side velocity boost for chained hops.
    "hopBoost": {
      "enabled": true,
      "factor": 1.08,
      "chainWindowMs": 1000,
      "maxSpeed": 1200.0
    },

    // Center-message the player when a grant is toggled ("grants" mode).
    "notifyPlayer": true
  }
}
