// Shared anticheat settings. Keep `observe` until each detector has been tested
// against live traffic; escalate detectors separately and aim detectors last.
{
  "anticheat": {
    "enabled": true,
    "mode": "observe",
    "banDurationSec": 0, // 0 = permanent
    "whitelistSteamIds": [],
    "allowSvCheatsTesting": false,
    "detections": {
      "aimbot": true,
      "aimlock": true,
      "antiAim": true,
      "silentAim": true,
      "dllInjection": true,
      "invalidCvar": true,
      "namechanger": true
    },
    "webhook": {
      // Use a private Discord channel during observation.
      "url": ""
    },
    "debug": {
      // Simulator commands are for the test server only.
      "simulator": true
    }
  }
}
