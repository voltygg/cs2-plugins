// Template for anticheat's settings.jsonc - rendered per (server, plugin) by
// deploy/tools/render.py. DB-less, no per-instance placeholders; every knob is
// a literal - edit it in git to change it.
//
// Detection thresholds are compiled in, not configurable: what is left here is
// the operational surface. Mode ladder: "observe" (log and report only, this is
// the dry run) -> "alert" (also notify admins via admin-system) -> "ban" (also
// kick or ban). Stays in "observe" until each detection has soaked against real
// traffic on this box; escalate module by module, aim modules last.
{
  "anticheat": {
    "enabled": true,
    "mode": "observe",
    "banDurationSec": 0, // 0 = permanent
    "whitelistSteamIds": [],
    "allowSvCheatsTesting": false,
    "detections": {
      "aimbot": true,
      "aimlock": true,
      "antiAim": true,
      "silentAim": true,
      "dllInjection": true,
      "invalidCvar": true,
      "namechanger": true
    },
    "webhook": {
      // Set to a private Discord channel webhook for the observe-mode soak.
      "url": ""
    },
    "debug": {
      // box-a is the test box; the simulator commands stay available here.
      "simulator": true
    }
  }
}
