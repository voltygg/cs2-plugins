// Template for anticheat's settings.jsonc, rendered by deploy/tools/render.py.
// DB-less with no per-instance placeholders: every knob is a literal, edited in
// git. Mode ladder: "observe" (log and report only) -> "alert" (also notify
// admins) -> "ban" (also kick or ban). Stays in "observe" until each detection
// has soaked against real traffic here; escalate module by module, aim last.
{
  "anticheat": {
    "enabled": true,
    "mode": "observe",
    "banDurationSec": 0, // 0 = permanent
    "whitelistSteamIds": [],
    "allowSvCheatsTesting": false,
    "detections": {
      "aimbot": true,
      "aimlock": true,
      "antiAim": true,
      "silentAim": true,
      "dllInjection": true,
      "invalidCvar": true,
      "namechanger": true
    },
    "webhook": {
      // Set to a private Discord channel webhook for the observe-mode soak.
      "url": ""
    },
    "debug": {
      // box-a is the test box, so the simulator commands stay available.
      "simulator": true
    }
  }
}
