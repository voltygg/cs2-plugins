// Template for admin-system's settings.jsonc - rendered per (server, plugin) by
// deploy/tools/render.py. Placeholders are filled from:
//   - inventory.yml (DB_HOST/DB_PORT/DB_USER/DB_SSLMODE + the plugin's DB_NAME)
//   - the server's env / SERVER_ENV secret (DB_PASSWORD, CHEAT_*)
// Non-secret, same-everywhere knobs stay literal here; edit them in git to change them.
{
  "plugin": {
    "logLevel": "info",
    "locale": "ru"
  },
  "server": {
    // Per-instance identity for per-server admin grants; rendered as <box>-<instance>
    // (e.g. "box-a-main"). Stable - renaming a box/instance orphans its grants.
    "tag": "${SERVER_TAG}",
    "name": "${SERVER_NAME}"
  },
  "database": {
    "host": "${DB_HOST}",
    "port": ${DB_PORT},
    "database": "${DB_NAME}",
    "username": "${DB_USER}",
    "password": "${DB_PASSWORD}",
    "sslMode": "${DB_SSLMODE}"
  },
  "punishments": {
    "defaultBanReason": "Banned by administrator",
    "warningThreshold": 3,
    // Quick Punish presets shown in the admin menu. type: "ban" | "voiceMute" | "textMute".
    // duration: "perm" (or "0") for permanent, otherwise <n>s / <n>m / <n>h / <n>d.
    // Invalid entries are skipped with a warning in the server log.
    "templates": [
      { "name": "Читы", "type": "ban", "duration": "perm", "reason": "Читы" },
      { "name": "Гриферство", "type": "ban", "duration": "1d", "reason": "Урон по своим / гриферство" },
      { "name": "Спам в микрофон", "type": "voiceMute", "duration": "30m", "reason": "Спам в микрофон" },
      { "name": "Токсичный войс", "type": "voiceMute", "duration": "2h", "reason": "Токсичное поведение в голосовом чате" },
      { "name": "Спам в чат", "type": "textMute", "duration": "30m", "reason": "Спам в чате" },
      { "name": "Токсичный чат", "type": "textMute", "duration": "2h", "reason": "Токсичное поведение в чате" }
    ],
    // Preset reasons offered in the manual menu punish flow (a free-text "Custom..." row is always added).
    "reasonPresets": [
      "Читы",
      "Токсичное поведение",
      "Спам в микрофон",
      "Урон по своим / гриферство",
      "Неприемлемый никнейм"
    ],
    // Rows of the menu duration picker (same grammar as template durations).
    "menuDurations": ["5m", "30m", "1h", "1d", "7d", "perm"]
  },
  "abuseProtection": {
    // Auto-freeze an admin's privileges when they exceed these per-window action counts
    // (counted across all servers). 0 disables a counter; root admins are exempt.
    "enabled": true,
    "windowMinutes": 10,
    "maxBans": 5,
    "maxKicks": 10,
    "maxMutes": 15,
    "maxWarnings": 15
  },
  "chat": {
    "broadcastPunishments": true,
    "tagAdminChatMessages": true,
    "fallbackPrefix": "[ADMIN]",
    "fallbackPrefixColor": "red",
    "fallbackNameColor": "default",
    "fallbackMessageColor": "default"
  },
  "cheatCheck": {
    "mode": "websiteAutoRoom",
    "timeoutSec": 120,
    "autoKick": true,
    "kickReason": "Failed to comply with cheat check",
    "panelRefreshMs": 100,
    "moveToSpectator": true,
    "bannerImageUrl": "",
    "bannerWidth": 320,
    "bannerHeight": 180,
    "fixedLink": {
      "url": "https://discord.gg/meatgg"
    },
    "websiteAutoRoom": {
      "createRoomUrl": "https://meat.gg/api/rooms",
      "apiKey": "${CHEAT_API_KEY}",
      "authHeader": "X-API-Key",
      "authScheme": "",
      "requestBody": {
        "purpose": "CHEAT_CHECK",
        "title": "Cheat check: {playerName}",
        "isLocked": false,
        "adminSteamId": "{adminSteamId}",
        "metadata": { "reason": "Suspect {playerName} ({steamId}) - by {adminName}" }
      },
      "playerUrlField": "code",
      "playerUrlTemplate": "https://meat.gg/rooms/{value}",
      "checkerUrlField": "code",
      "checkerUrlTemplate": "https://meat.gg/rooms/{value}",
      "timeoutMs": 8000,
      "presenceUrl": "https://meat.gg/api/rooms/{code}/presence?steamId={steamId}",
      "presenceField": "present",
      "pollIntervalSec": 5
    }
  }
}
